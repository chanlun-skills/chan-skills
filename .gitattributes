# 统一行尾，避免跨平台协作时整文件 diff
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.woff binary
*.woff2 binary

# Python 脚本保持 LF
*.py text eol=lf

# Markdown / YAML / JSON / CSV 保持 LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
