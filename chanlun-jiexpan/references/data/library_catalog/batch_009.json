2008}}, {"标题": {"text": "煎熬了两天"}, "发布时间": {"date": "2008-05-22"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1218.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": ""}, "正文字数": {"number": 13}, "年份": {"number": 2008}}, {"标题": {"text": "今天基本恢复"}, "发布时间": {"date": "2008-05-24"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1219.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "化疗后的反应还是很大的,主要是白细胞下降太快,第一天时只有1000,正常是4000-10000,不过,这三天已经恢复过来。"}, "正文字数": {"number": 234}, "年份": {"number": 2008}}, {"标题": {"text": "说点想说的话：给现在、未来的人类"}, "发布时间": {"date": "2008-05-25"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1220.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这次的病，说实话，并不是本ID预计中的事情。本ID又没有神通，不过平凡人一个，只是一个永远只愿意站立的人，而且希望探索、展示人的所有潜能、可能的人。"}, "正文字数": {"number": 1949}, "年份": {"number": 2008}}, {"标题": {"text": "出院两天，旧词一首寄心情"}, "发布时间": {"date": "2008-05-27"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1221.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "出院时验白细胞，已经停针好几天，结果是1.7万，因此可以安心出院了。在外面游了两天，心情正好，现在写诗词太费神，用旧词一首寄之。"}, "正文字数": {"number": 208}, "年份": {"number": 2008}}, {"标题": {"text": "七律一首报平安"}, "发布时间": {"date": "2008-06-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1222.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "浊世无心辩圣凡，残躯浪把酒杯衔。独行哪畏人言炙，万死何来鬼眼馋。天大踏云驱日马，风高扬梦竞星帆。时轮滚滚山河脆，一味酸甜苦辣咸。"}, "正文字数": {"number": 116}, "年份": {"number": 2008}}, {"标题": {"text": "难得糊涂，难得有病"}, "发布时间": {"date": "2008-06-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1223.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "至于股市，没什么可担心的，现在已经走得超级完美，一直顺着60天线调整，一旦再站上本ID一直强调的分水岭3656点，就直接上60天线，行情就可以发动了。最近注意一下布林通道，不排除先破再立，深挖井才可以广积粮。"}, "正文字数": {"number": 570}, "年份": {"number": 2008}}, {"标题": {"text": "国朝三圣(附解盘)"}, "发布时间": {"date": "2008-06-04"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/3saints"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "前两天乌鸦嘴了一把，让各位注意布林通道，小心最近先破位，现在，最坏的情况是走最后一跌，破3000而下，如果大盘足够肾水，那么也可能皆大欢喜一把，双底而起，后面就是如此这般了，散去吧。"}, "正文字数": {"number": 484}, "年份": {"number": 2008}}, {"标题": {"text": "该如何评价历史人物(附录解盘)"}, "发布时间": {"date": "2008-06-05"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/historicalevaluation"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "总有一些无聊之辈，爱以一些自己都遵守不了的道德标准在历史人物身上挑刺，其实，换到那种状态下，这些人只会干得更龌龊。历史那些给文革之类挑刺的人，所谓共党残酷斗争历史挑刺的人，去看看你们那民主选举的台湾上演的闹剧吧，别以为国民党就是什么好鸟，他们的作为在以前比民进党要龌龊一万倍，历史从来都是这样，真正在台上的永远是少数人，这些人能站上去，踏着的总是大众的尸骨。看看小布什，这么垃圾的一个人，怎么还能连任？是什么力量使一个如此垃圾的人在一个号称民主自由选举万岁的国家得到如此不光彩的连任？原因很简单，利益，在台上，一切利益资源都控在手里，所谓的选举，不过是些媒体游戏，在一个媒体侵略到每个人中枢神经的经济社会里，人不过是这些编剧的操纵物，特别对于一般的人，那些没有主见脑子有水的人，这是最正常不过的事情，而这种人，总是人群里的绝大多数。"}, "正文字数": {"number": 1778}, "年份": {"number": 2008}}, {"标题": {"text": "21世纪依然担心言论自由的中国人是可耻的(附录解盘)"}, "发布时间": {"date": "2008-06-06"}, "主题": {"multi_select": ["大盘解盘"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/freedomofexpression"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "本ID每次反弹都把最后走的位置说好了，记得这次是多少点吗？3656！就算你没勇猛到3656上盘整顶背驰走，那么有效跌破3656点还不走，那能怪谁？现在大盘爱到多少点是多少点，反正缺口上能站稳，咱们就再进去折腾一把，站不稳，就让它见越南盾去吧！"}, "正文字数": {"number": 1443}, "年份": {"number": 2008}}, {"标题": {"text": "各位端午节好，说说本ID现在的情况"}, "发布时间": {"date": "2008-06-07"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1227.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "其实，本ID重新发帖的那天也就重回医院了。不过这次又换了一家，没去地方上的医院，当然也是最好的，这方面，本ID是不会为难自己的。"}, "正文字数": {"number": 599}, "年份": {"number": 2008}}, {"标题": {"text": "大病识人"}, "发布时间": {"date": "2008-06-08"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1228.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "辩市不易，识人大难。一场大病，所得良多，其中一项，就在这识人更多上。死生时刻，一切虚情假意都褪去伪装，是什么花花肠子，大分明矣。这次，不少人在本ID只有三月性命的通告中原形毕露.这里说的都是现实中人，一场好戏，扒尽人间假面具。假面具褪尽，真心友、生死交自然呈现，不识而识矣。"}, "正文字数": {"number": 523}, "年份": {"number": 2008}}, {"标题": {"text": "诗人画廊（三）：屈原/太白"}, "发布时间": {"date": "2008-06-09"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1229.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "病前说过要用七律给世界上自古以来本ID看得上眼的诗人画像，组成一诗人的画廊。既然现在病情有所稳定，本ID也要继续履行诺言，画廊今天重新开张，刚过端午，那就从屈先生开始，顺带上太白老顽童。"}, "正文字数": {"number": 241}, "年份": {"number": 2008}}, {"标题": {"text": "关于越南危机，中国责无旁贷该负起应有的大国责任！"}, "发布时间": {"date": "2008-06-09"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1230.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "中国是一个大国，大国就该有大国的样子，一个大国，无论出自什么目的，人道的、责任的、经济的，干出来的事情都应该有大国风范，否则，不仅会被黑社会的大哥大姐耻笑，更会被其他弱小的国家所逐渐抛弃，离心而去了。"}, "正文字数": {"number": 1214}, "年份": {"number": 2008}}, {"标题": {"text": "今年诸多灾难与妖蛾子事的历史性解释"}, "发布时间": {"date": "2008-06-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1231.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这里首先把盘子解一下。在市场中，第一就要分清楚预测与操作的严重区别：预测是游戏，是茶余饭后的谈资；而操作是真刀真枪去干，是血与火的斗争。绝对的预测归根结底都是笑话，而非绝对的操作归根结底是死路一条。像这次，绝对的操作是怎么样，本ID早已反复说明：3656点站不住走，3300缺口位置不回补可以回补筹码再短差一把，否则就让大盘越南盾去。这里，整个操作的设计是没有任何不确定的地方，都是绝对性的，这才能股票股票而不是被股票股票，而任何预测都只能永远在被股票股票的死路上轮回。"}, "正文字数": {"number": 1810}, "年份": {"number": 2008}}]