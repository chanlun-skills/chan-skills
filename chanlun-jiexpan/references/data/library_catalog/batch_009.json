2008-05-05"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/cautionshocking"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天，上攻力度明显趋弱，以板块补涨为主，所以，大的震荡风险已经开始积聚。3840点的中线意义已经早说，注意该点位上下表现。"}, "正文字数": {"number": 164}, "年份": {"number": 2008}}, {"标题": {"text": "该强不强小心陷阱终被验证"}, "发布时间": {"date": "2008-05-07"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1208.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "节前已强调,节后该强不强小心陷阱,而周一又再次提醒,因此今天的走势完全在预料之中.现在中线很简单,还是看3656点,强弱分水岭.站不住甚至不排除二次探底."}, "正文字数": {"number": 207}, "年份": {"number": 2008}}, {"标题": {"text": "3656点上下的艰苦选择"}, "发布时间": {"date": "2008-05-08"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1209.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "3656上下的重要意义已经反复说,至于如何选择，根本没必要预测，只要保持如此市场节奏，那就3656点下跌不动就买，之上或附近涨不起就抛，不断短差。"}, "正文字数": {"number": 244}, "年份": {"number": 2008}}, {"标题": {"text": "瞎猫撞上了死耗子"}, "发布时间": {"date": "2008-05-09"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1210.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "大盘最近无须多说,就3656点的中枢震荡和第三买卖点问题，明白这一总格局，就一切随心了。"}, "正文字数": {"number": 378}, "年份": {"number": 2008}}, {"标题": {"text": "明天开始化疗"}, "发布时间": {"date": "2008-05-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1211.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "明天是水化，连续十几小时的注射，听说是几千毫升的量。后天开始上药，最开始就是那最危险的药，三小时。"}, "正文字数": {"number": 393}, "年份": {"number": 2008}}, {"标题": {"text": "人体机器的一面"}, "发布时间": {"date": "2008-05-11"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"