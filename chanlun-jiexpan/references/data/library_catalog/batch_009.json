[{"标题": {"text": "教你炒股票100：中医、兵法、诗歌、操作3"}, "发布时间": {"date": "2008-02-25"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1127.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这点，前面已经反复说过。但完全的分类，不是单层次的，一定也必须是多层次的。本ID的理论最重要的特点之一，就是自然给出了分类的层次，也就是不同的自然形成的级别。不同的级别，有不同的完全分类，而综合起来，就有了一个立体的完全分类的系统，这才是我们的操作必须依赖的。"}, "正文字数": {"number": 1650}, "年份": {"number": 2008}}, {"标题": {"text": "无技术含量救市已审美疲劳"}, "发布时间": {"date": "2008-02-26"}, "主题": {"multi_select": ["中枢结构", "政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/futilebailout"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "当然，从超短线的角度，昨天已明确指出1分钟底背驰出现后的机会。今天的走势，简直是超级教科书，下午一开盘的第三类卖点，然后再破底，在2点半形成最后的底背驰，如此教科书的走势，如果都不能看明白并操作，那么唯一的办法就是继续读书。"}, "正文字数": {"number": 634}, "年份": {"number": 2008}}, {"标题": {"text": "4391点决定短线走势"}, "发布时间": {"date": "2008-02-27"}, "主题": {"multi_select": ["中枢结构", "牛熊判断", "比例线与点位"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/4391points"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "昨天说了，今天不创新低且冲上4331点就构成底分型，今天的走势也很争气地达到了最基本的目标。但是，站在严格的意义上，这不是最强的走势，因为整个底分型的上边沿在4391点，也就是前天的高点，最强的走势就是今天直接攻上这点上。"}, "正文字数": {"number": 1440}, "年份": {"number": 2008}}, {"标题": {"text": "捍卫马克思8：马克思意义社会主义实现的唯一渠道"}, "发布时间": {"date": "2008-02-27"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/marx8"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "资本全球化所达到极限之前，还有很长的路要走，其中最急迫的一个阶段，就是本ID反复强调的12亿5千万级别的阶段，这是资本全球化极限前最后一个分列的阶段，谁成为这个阶段的主导国，将是有着决定性历史意义的。"}, "正文字数": {"number": 1411}, "年份": {"number": 2008}}, {"标题": {"text": "穷疯浦发让大盘再陷彷徨"}, "发布时间": {"date": "2008-02-28"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1131.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天已经说了，这两天本来是大盘短线很关键的时间，也就是MACD红柱子能否再度出现的时间，这时候任何风吹草动都会让脆弱大盘受到惊吓。"}, "正文字数": {"number": 594}, "年份": {"number": 2008}}, {"标题": {"text": "要通胀还是要经济增长"}, "发布时间": {"date": "2008-02-28"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1132.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "关于这两个选项，无非有四种完全分类：高通胀高增长、高通胀低增长、低通胀高增长、低通胀低增长。前面，我们一直在低通胀高增长的阳光下幸福着，但这种状态不可能永远存在，也就是说，其余三个选项也有可能成为现实的走势。"}, "正文字数": {"number": 979}, "年份": {"number": 2008}}, {"标题": {"text": "大盘已具备上攻的所有技术条件"}, "发布时间": {"date": "2008-02-29"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1133.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天，MACD的红柱子终于再度出现，这是黄白线两次缠绕后的结果，所以在技术上特别值得重视。一般情况下，这种走势都将使得黄白线重新回到0轴附近，对应着大盘将有一轮上攻走势。但是，往往是这种情况下，最容易出现骗线，骗线不常出现，一般10次里可能也不到1次，不过这种可能性是存在的。"}, "正文字数": {"number": 719}, "年份": {"number": 2008}}, {"标题": {"text": "站稳4391，剑指4695点。"}, "发布时间": {"date": "2008-03-03"}, "主题": {"multi_select": ["政策与基本面", "中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/towarding4695"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "大盘今天终于按最通常的方式突破4391点，早上那本年度至今最衰股票中国平安并没有把大盘再次引向下跌，而外围股市的大跌走势也没产生大的影响，究其原因，是我们自己内部基本面有了一些更大的支持，抵消了相应的影响，使得大盘的突破终于如愿。"}, "正文字数": {"number": 888}, "年份": {"number": 2008}}, {"标题": {"text": "捍卫马克思9：共产主义需要被信仰吗？"}, "发布时间": {"date": "2008-03-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1136.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这世界上自以为是的蠢人太多，例如，这些蠢人会提这样的质问：如果大家都不信仰共产主义，或者不信仰的比信仰的多，共产主义还能实现吗？"}, "正文字数": {"number": 1079}, "年份": {"number": 2008}}, {"标题": {"text": "增发再成行情杀手"}, "发布时间": {"date": "2008-03-04"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1137.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说了，大盘由于没有出现真正的第三类买点，技术依然可以跌回原来4331点中枢，基本面上的相应配合就是平安通过增发。不过今天一开始的消息面，已经等不到明天平安的开会了，深发展的增发传闻使得大盘立刻转折向下，一举实现再回原来中枢的壮举。"}, "正文字数": {"number": 957}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票101：答疑1"}, "发布时间": {"date": "2008-03-04"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/101"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "第一类买卖点就是背驰点，第三类买卖点就是中枢破坏点，这都是很清楚的。而这第二类买卖点，好象还是有很多不明白。"}, "正文字数": {"number": 1557}, "年份": {"number": 2008}}, {"标题": {"text": "选股首先要讲政治"}, "发布时间": {"date": "2008-03-05"}, "主题": {"multi_select": ["板块与个股", "中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/politicallystockselecting"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天平安顶风作案成功都在预料之中，不过尚先生关于将严查巨额融资的表态，暂时抵消平安闹剧的影响。由于平安方面肯定要粉饰太平，所以一定会对自己的股票进行护盘动作以争取管理层的通过，所以，平安的走势将逐步稳定甚至会对大盘短线产生支持。"}, "正文字数": {"number": 1215}, "年份": {"number": 2008}}, {"标题": {"text": "平安粉饰性护盘闹剧如期上演"}, "发布时间": {"date": "2008-03-06"}, "主题": {"multi_select": ["板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1140.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天已经明确说了，平安为了得到管理层的认可，肯定要进行相应的护盘制造他们需要的气氛，今天，这护盘闹剧如期上演。唯一的好处，昨天也说了，就是让大盘有了短线的支持，但这样的闹剧，如果最终得逞，中国资本市场的信誉将彻底破产。"}, "正文字数": {"number": 826}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票102：再说走势必完美"}, "发布时间": {"date": "2008-03-06"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1141.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "如果是单纯地唯一分解，并不能显示本ID理论真正厉害之处，因为走势必完美对应的是一种最特殊、最强有力的唯一分解，这看似毫无规律的市场走势竟然有这样完美的整体结构，这才是最牛的地方。"}, "正文字数": {"number": 1678}, "年份": {"number": 2008}}, {"标题": {"text": "平安应停牌以维护市场稳定"}, "发布时间": {"date": "2008-03-07"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/pingansuspension"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "平安的一天闹剧被揭穿后马上露出本来面目，像平安如此大的动作，而且平安自身又深度介入二级市场，无论如何，在其增发有管理层的最终结论前，都应该停牌。否则，像现在一样，一个股票完全影响市场的走势，对市场的稳定是极大的伤害。"}, "正文字数": {"number": 694}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐27：念佛、修密、参禅之痴汉"}, "发布时间": {"date": "2008-03-08"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1143.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "有这般痴汉，翳眼生华，称此地为污土，彼地为净土，行如基督教之苟且事，却不知此娑婆世界，何处非黄金为地、琉璃布天？以彼之漏眼，安可辩之？ 西方无净土、东方非污土，皆尔心之造作。念佛者，实念无相之自我天真佛，乃亿万莲花往生不可换也。而痴汉之念佛，以六识之妄识行之，安有出期？ 花开见佛，实有其事，但以此为执，则亿万佛出世也救之不得。无此识见，妄称念佛。 有这般痴汉，称修密而即身成佛，不过自欺欺人，其所成就者，犹不及大罗汉之一二，安言成佛？一身与亿万身，不过幻中游戏；一世与三大劫，亦不过梦中演排。于此妄分甲乙，可怜可悯矣。 更有这般痴汉，称参禅而一悟成佛。而佛者何曾迷？无迷何须悟？尔等悟者实大误也。若参禅有所悟，则皆有求之痴心作怪，因悟更迷，可悯可怜矣。 念佛、修密、参禅，皆万千法门之一门。而条条菩提路，处处涅磐门，岂是尔等善恶得失之妄心可测度？ 真修行者，成一切魔王、入一切污土，于地狱三涂而成就"}, "正文字数": {"number": 512}, "年份": {"number": 2008}}, {"标题": {"text": "紧跟平安将破罐破摔进行到底"}, "发布时间": {"date": "2008-03-10"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1144.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "现在最大的问题是什么，用脚指头都能想明白。但管理层那已经成为滑稽表演的基金新发依然如故。那么，大盘也只好紧跟平安将破罐破摔进行到底了，没有比今天创新底更能配合管理层基金连发的滑稽与幽默了。"}, "正文字数": {"number": 1110}, "年份": {"number": 2008}}, {"标题": {"text": "夜郎自大的中国大机构"}, "发布时间": {"date": "2008-03-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1145.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "中国的大机构，在N年还是很蔫的。但因为出身正，几年光阴，现在都牛得不得了了。世界也500强了不少，个个鼻孔都插上了大葱。"}, "正文字数": {"number": 894}, "年份": {"number": 2008}}, {"标题": {"text": "回补周线缺口引发反弹"}, "发布时间": {"date": "2008-03-11"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1146.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天，所有人都盯着那被多空双方惦记了N个月的4062点上的周线缺口，结果，抢跑的不少，造成还差1点没补完。当然，对于短线来说，这并不特别重要。技术上，那1分钟的下跌也形成了，目前唯一需要确定的是，第二个中枢是直接第三类买点反弹上去，还是把a+A+b+B+c的c给走出来再标准背弛上去。"}, "正文字数": {"number": 1106}, "年份": {"number": 2008}}, {"标题": {"text": "让人无话可说的管理层"}, "发布时间": {"date": "2008-03-11"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/managementboard"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "显然，2007年后的市场表现，完全超越了管理层的想象力，因为他们根本就没有深刻理解这轮所谓流动性过剩制造的大行情的历史性意义。"}, "正文字数": {"number": 1783}, "年份": {"number": 2008}}, {"标题": {"text": "美国救市救不了中国股市"}, "发布时间": {"date": "2008-03-12"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1148.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "美国救市，大盘自作多情地大幅高开，结果不仅被彻底打回原形，还再次挑战新低，一日闹剧就此结束。"}, "正文字数": {"number": 1006}, "年份": {"number": 2008}}, {"标题": {"text": "我们需要怎样的管理层"}, "发布时间": {"date": "2008-03-12"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1149.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "首先，现在讨论这些问题，并不是本ID的个人问题，而是现在的问题，将严重威胁我们的大局，而这个大局，是全体中国人的。"}, "正文字数": {"number": 912}, "年份": {"number": 2008}}, {"标题": {"text": "信心危机引发多杀多"}, "发布时间": {"date": "2008-03-13"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/bullskillbulls"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "反复强调，现在已经是信心问题。信心危机下，今天引发多杀多，4000点成了纸糊的。不过，下午关于3G的利好引发联通快速上涨冲击涨停，使得大盘不至于收得过分难看。"}, "正文字数": {"number": 638}, "年份": {"number": 2008}}, {"标题": {"text": "我们需要怎样的投资者"}, "发布时间": {"date": "2008-03-13"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/aboutinvestors"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "显然，注定绝大多数投资者都是被市场愚弄的。而所有被愚弄的，都是陷在市场中，被自己所迷糊。这些人，所有的行为都被分类为多空两种形式，当自己拿着股票时，思维就被多头所控制，反之，就是空头的奴隶。"}, "正文字数": {"number": 811}, "年份": {"number": 2008}}, {"标题": {"text": "信心不是“应该有”就能有的"}, "发布时间": {"date": "2008-03-14"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/confidence"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "技术上，现在在4000点下又搞出一个1分钟中枢，也就是这次1分钟的下跌已经有3个中枢了，一般来说，这意味着短线的反弹随时出现，但这反弹若只能在4000点上下形成一个5分钟中枢，那么，后面一旦演化成5分钟下跌的第一个中枢，其压力可想而知。至于这个1分钟下跌结束制造的反弹是背驰还是盘整背驰产生的，本质上没多大差别。"}, "正文字数": {"number": 810}, "年份": {"number": 2008}}, {"标题": {"text": "七律：二月"}, "发布时间": {"date": "2008-03-15"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1153.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "约了人去郊游，所以打坐的帖子不能写了，用一首七律替代。各位也别浪费这大好春光，就算你活一百岁，能见到的也就是100次，珍惜吧。"}, "正文字数": {"number": 165}, "年份": {"number": 2008}}, {"标题": {"text": "多杀多蔓延加速短期底部来临"}, "发布时间": {"date": "2008-03-17"}, "主题": {"multi_select": ["中枢结构", "牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/shortbottomcoming"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天，如前期所说，那些对会议还有冀望的人终于也杀出来了，当然，现在还缺一些死多头去献出胳膊和腿，没有这些胳膊和腿，大盘的反弹是不会有力度的。"}, "正文字数": {"number": 892}, "年份": {"number": 2008}}, {"标题": {"text": "古典诗歌中的用典"}, "发布时间": {"date": "2008-03-17"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1155.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "古典诗歌中的用典，是一个重要的问题。因为，诗歌的字数就那么多，一些极端复杂的东西，必须通过巧妙的用典那进行化解。"}, "正文字数": {"number": 618}, "年份": {"number": 2008}}, {"标题": {"text": "今天尾盘开始买入股票"}, "发布时间": {"date": "2008-03-18"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1156.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "每天的走势，其实本ID都描述得很清楚，例如昨天已经说得很清楚，今天将有对记者会绝望的再杀出来，而记者会其间是一个震荡，这都在今天的走势中很明确的反应了，看看记者会后那杀跌，难道不是吗？"}, "正文字数": {"number": 752}, "年份": {"number": 2008}}, {"标题": {"text": "自知之明"}, "发布时间": {"date": "2008-03-18"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1157.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "单边市永远是稀有的，像前两年那种走势，十年都难得一遇。市场归根结底，以震荡为主，而震荡最终产生的利润，绝对不少于单边，不会震荡的人，在市场上就少了一种武器，坐电梯是小事，往往就落在井里上不来了。"}, "正文字数": {"number": 1017}, "年份": {"number": 2008}}, {"标题": {"text": "3775点决定反弹能否延续"}, "发布时间": {"date": "2008-03-19"}, "主题": {"multi_select": ["中枢结构", "牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1158.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "我们现在只是纯技术性地探讨走势，那么，3775点能否站稳将决定大盘反弹能否延续。今天一大早高开后回试是一个次佳的买入机会，为什么？看看60分钟图就知道，这刚好构成底分型。而3775点，刚好是这底分型的上边沿。"}, "正文字数": {"number": 658}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票103：学屠龙术前先学好防狼术"}, "发布时间": {"date": "2008-03-19"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1159.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "学屠龙术前先学好防狼术吧，本ID看现在绝大多数是连防狼术都没过关，大盘稍微来点劲，就会被大盘严重侵犯。"}, "正文字数": {"number": 783}, "年份": {"number": 2008}}, {"标题": {"text": "2008年行情再展望"}, "发布时间": {"date": "2008-03-20"}, "主题": {"multi_select": ["牛熊判断", "大盘解盘"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1160.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "抱歉，由于一西南地区上市公司的股权收购问题需要和法院和银行接触，下午可能等不到收盘就要去开会，所以今天的解盘和后面的帖子都没有了。现在用昨天写好的一个行情展望替代，要把握大的方向，请好好研究。"}, "正文字数": {"number": 2186}, "年份": {"number": 2008}}, {"标题": {"text": "3780点，短线生命线。"}, "发布时间": {"date": "2008-03-21"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1161.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "现在，当然不能说大盘就没有再次探底的可能，但大盘底部至少有一只脚是落地了，现在唯一需要探讨的只是这底部是独脚的还是双脚的甚至是多脚的。而决定这一切的，就是这3780点，这是60分钟新的底分型的上沿位置，只要站住这个位置，那么，至少在60分钟图上，将延伸出向上的笔，而这意味着这反弹是独脚的。"}, "正文字数": {"number": 1102}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐28：本质上，一切众生都是无知的"}, "发布时间": {"date": "2008-03-22"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1162.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "在未最终成佛之前，本质上，一切众生都是无知的。即使是十地菩萨，可化生为大魔王，行各种不可思议之事，仍然有无知的地方。"}, "正文字数": {"number": 853}, "年份": {"number": 2008}}, {"标题": {"text": "3780生命线失守再次探底"}, "发布时间": {"date": "2008-03-24"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1163.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "上周五已经超级明确地说了，3780点是短线生命线，站不住就再次探底。今天早上，跌破3780点后两次反抽上不去，确认跌破有效。然后下午2点那标准的第三类卖点成立后，跌幅明显加大。一切都极端技术化。"}, "正文字数": {"number": 564}, "年份": {"number": 2008}}, {"标题": {"text": "抱歉，以后不能保证每天都有帖子"}, "发布时间": {"date": "2008-03-24"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1164.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "最近，本ID写帖子的时候已经有点厌倦的感觉。并不是因为这世界上白眼狼众多，也不为了其他别的原因。只是本ID天生厌倦一切过于重复性的活动，例如上班。至于股票，唯一能让本ID忍受的是每天的行情都不同，这至少可以减轻厌倦感，但每周五都有放风的感觉。"}, "正文字数": {"number": 350}, "年份": {"number": 2008}}, {"标题": {"text": "万事具备只待平安事了"}, "发布时间": {"date": "2008-03-25"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1165.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "众所周知，这次从5522点开始共2000点的下跌，导火索就是平安，因此，在目前的底部震荡中，其实已经万事具备，但就差这平安破事最后有一个众望所归的结果，这也算是大盘最终走出底部震荡的一个最基本的心理支持。"}, "正文字数": {"number": 601}, "年份": {"number": 2008}}, {"标题": {"text": "3616点，短线关键。"}, "发布时间": {"date": "2008-03-26"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1166.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天让各位注意5分钟MACD站稳0轴后上攻的情况，结果今天早上走出一个标准的盘整背驰，红柱子小于前面一组，而也只带动了15分钟MACD回拉0轴受阻，因此其后的回落就理所当然了。"}, "正文字数": {"number": 637}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票104：几何结构与能量动力结构1"}, "发布时间": {"date": "2008-03-26"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1167.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID的理论是一个超级完美的理论，第一是在数学的角度超级完美，其次，是在物理的角度超级完美。物理角度，以前说的不多，因为这需要的思维方式，同样要有一个大的改变。"}, "正文字数": {"number": 789}, "年份": {"number": 2008}}, {"标题": {"text": "破发竞赛宣泄市场情绪"}, "发布时间": {"date": "2008-03-27"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/marketemotions"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天的走势，昨天已经说得很清楚了，就是上次580989从0.4下启动时的翻版，那次同时带动了大盘的破位，这次如出一辙。各位可以对比一下上次的走势，后面的走势是否继续一样，这是一个很值得关注的问题。"}, "正文字数": {"number": 870}, "年份": {"number": 2008}}, {"标题": {"text": "3424点初显威力"}, "发布时间": {"date": "2008-03-28"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/3424points"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "而昨天也说了，和上次580989在0.4下启动那次一样，引领大盘破底后，大盘最终又再次回到破底前的平台，今天的走势证明，这太阳底下，新鲜事并不多。"}, "正文字数": {"number": 1090}, "年份": {"number": 2008}}, {"标题": {"text": "3499点继续决定短线命运"}, "发布时间": {"date": "2008-03-31"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1171.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "由于该位置今天是震荡中心，所以明天如果能站上去，大盘还有点戏，否则，继续探底就不可避免了。底部不是一天成的，今天显然已经比以前类似的情况走得稍好一点，显示已经有一点新资金介入并对此位置有一定的信心，否则，今天将是单边下跌。因此，明天的走势很关键，如果能回拉上去，证明新资金的信心还是比较足。"}, "正文字数": {"number": 528}, "年份": {"number": 2008}}, {"标题": {"text": "七律：兽语（可别对号入座）"}, "发布时间": {"date": "2008-03-31"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1172.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "鹰飞鹿走虎狼谋凤附龙攀蛇鼠殴岂有官场不拍马何时政客少吹牛眼空惟见云中鹤名大须谈海上鸥豕喙驴唇鸦鸭嘴犬羊螂雀更鸡猴"}, "正文字数": {"number": 106}, "年份": {"number": 2008}}, {"标题": {"text": "漫画：七律--国朝公仆"}, "发布时间": {"date": "2008-04-01"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1173.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "国朝公仆竞清廉各执鸡毛扮老阎软硬短长双手搏青红皂白一身兼心花暗逐顶花放眼水长随口水淹万丈云梯骨堆就千年竹更美名添"}, "正文字数": {"number": 116}, "年份": {"number": 2008}}, {"标题": {"text": "下一个短线机会又将来临"}, "发布时间": {"date": "2008-04-01"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1174.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "别让本ID看不起，每次短线，本ID都把最后的走人位说得一清二楚，就象这次的3499，今天早上连续冲了两次不行，就开始大幅度下行，如果你这你都看不明白，还是去孔男人那里吧，你这样的水平在这里只有丢人的份。或者就自知之明一点，在自己额头上写好永不短线，因为自己无能。"}, "正文字数": {"number": 630}, "年份": {"number": 2008}}, {"标题": {"text": "现阶段中国资本市场的地位"}, "发布时间": {"date": "2008-04-01"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1175.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "一个成熟的市场经济，其市场中心地位的就是资本市场，资本市场的任何风吹草动，都是国家级的大事。看看，这次次贷危机，美国股市的实际跌幅度一点都不大，连20%都没有。但已经是朝野倾动而出，用进一切的金融、财政、政府等的资源来稳定资本市场。为什么在美国以及西方所有的成熟市场经济国家，资本市场具有如此举足轻重的地位？因为，这是他们经济结构的核心，后面代表着最大多数人的利益。也就是说，这些成熟的市场经济国家，其经济已经进化到如此的境地，绝大多数公民的经济利益都与资本市场密切相关，而经济基础决定上层建筑，自然，没有任何的政府机构敢对资本市场有丝毫的怠慢。"}, "正文字数": {"number": 817}, "年份": {"number": 2008}}, {"标题": {"text": "3462点成短线关键位置"}, "发布时间": {"date": "2008-04-02"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/key3462points"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天，如期反弹，然后大幅度震荡。一般这种走势，最好就是进行对冲式操作，或者如昨天本ID所说，昨天尾盘就可以先介入。"}, "正文字数": {"number": 423}, "年份": {"number": 2008}}, {"标题": {"text": "3462点如期发挥神奇作用"}, "发布时间": {"date": "2008-04-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/3462pointsworks"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天的走势大概出乎很多人的意外，但一定不包括本ID以及昨天看了本ID解盘的人。昨天的解盘很明确地告诉你要再来一次，请问，这一次爽吗？"}, "正文字数": {"number": 695}, "年份": {"number": 2008}}, {"标题": {"text": "3613点成中短线关键位置"}, "发布时间": {"date": "2008-04-07"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1178.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "大盘今天突破短线关键位置3462点后一马平川，60分钟上N个月来第一次延伸出向上笔走势，显然了大盘的短线强势。"}, "正文字数": {"number": 562}, "年份": {"number": 2008}}, {"标题": {"text": "中国人，不要习惯性当政府的奴才。"}, "发布时间": {"date": "2008-04-07"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1179.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "衙门型管理机构，甚至可以有这样一种可怕的思维，跌比涨好，跌就是安全，资本市场里的人的行为最好都完全统一到银行存款行为上去，这样就不惹事，不惹事就是最大的好事。正因为这十几年那如此思维的存在，因为中国的资本市场走势都显示出最大的投机性，因为大家都知道上涨的时日无多，一旦有机会就变本加厉地投机，尽量在最短时间内把最大的利润拿到手。"}, "正文字数": {"number": 1008}, "年份": {"number": 2008}}, {"标题": {"text": "3613点如期发挥神奇作用"}, "发布时间": {"date": "2008-04-08"}, "主题": {"multi_select": ["板块与个股"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1180.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "个股方面，板块轮动加速，现在问题的关键是轮动后首先调整的板块能否再次启动，能，那大盘就肯定有戏，否则至少要调整一下。"}, "正文字数": {"number": 454}, "年份": {"number": 2008}}, {"标题": {"text": "3613点威力尽显"}, "发布时间": {"date": "2008-04-09"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1181.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的走势极端技术化，前面已经明确说了，只要站不住3613点，就要再次探底。今天低开后，在60分钟刚好跌破顶分型的下边，早上那标准的回抽，极端显然地上不了3613点，因此确认这对顶分型下边的跌破是有效的，因此后面的下跌就顺理成章了，为什么？因为向下要形成笔。"}, "正文字数": {"number": 518}, "年份": {"number": 2008}}, {"标题": {"text": "3533点成短线关键位置"}, "发布时间": {"date": "2008-04-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/key3533points"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天，又一个完美的短线机会，60分钟的底分型成立，而3533点成短线关键位置，所谓的关键位置，就是站上去，大盘将继续延续反弹，也就是2次探底结束；站不住，就必然再次探底，而且破底的机会极大。"}, "正文字数": {"number": 378}, "年份": {"number": 2008}}, {"标题": {"text": "周底分型成立令3840点成中线关键"}, "发布时间": {"date": "2008-04-11"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1184.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本周折腾，最后的结果还是把周底分型给折腾出来了，该分型的上边在3840点，因此，该分型是否最终有效，延伸为向上笔，或者最终失败，只构成中继型，3840点就成了周级别的关键位置了。"}, "正文字数": {"number": 349}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票105：远离聪明、机械操作"}, "发布时间": {"date": "2008-04-13"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1185.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "最近，不写课程，但其实一直都在写，每天，就是用一个最简单的分型以及能否延伸为笔的最基本标准进行分类，就完全可以处理如此震荡的行情，人总爱复杂的东西，看不起简单的，而这才是真工夫。"}, "正文字数": {"number": 886}, "年份": {"number": 2008}}, {"标题": {"text": "又一短线机会扑面而来"}, "发布时间": {"date": "2008-04-14"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1186.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "现在这种行情，本ID一早就给出两种唯一的策略供不同水平的人选择，一是小板凳，二是短跑运动。本ID之所以天天在这里给各位练习短跑，就是假设你有这水平。否则，小板凳的过来看看就可以。"}, "正文字数": {"number": 541}, "年份": {"number": 2008}}, {"标题": {"text": "如约反弹，3311点成短线关键"}, "发布时间": {"date": "2008-04-15"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/key3311points"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "个股只要能轮动起来，这反弹就能持续。至于中线大盘，过几天有心情再和各位分析，总之，已经在最后的空头陷阱中了。"}, "正文字数": {"number": 434}, "年份": {"number": 2008}}, {"标题": {"text": "CPI让多空有了再次较劲的理由"}, "发布时间": {"date": "2008-04-16"}, "主题": {"multi_select": ["中枢结构", "政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/fightagain"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天，大盘全天和CPI震荡较劲，而震荡的中心就是昨天说的短线关键位置3311点。而最终得到的数据，多空双方都能从中找当适合的说辞，空方自不必说了，而多方看到CPI月环比的回落，当然也有了说道的地方。"}, "正文字数": {"number": 591}, "年份": {"number": 2008}}, {"标题": {"text": "破底再给短线机会"}, "发布时间": {"date": "2008-04-17"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1189.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "3311站不住，自然就要破底，这没什么可说的，但这就又成就新一轮419，一个新的短线机会又到面前。"}, "正文字数": {"number": 223}, "年份": {"number": 2008}}, {"标题": {"text": "告示：以后的帖子可能极端没规律"}, "发布时间": {"date": "2008-04-17"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/irregularposts"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "现在这博客已经成为本ID最大的一个负担，本来想关闭一段时间，等把手头的事情忙完再重开。"}, "正文字数": {"number": 367}, "年份": {"number": 2008}}, {"标题": {"text": "后市纯技术分析展望"}, "发布时间": {"date": "2008-04-18"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/technicalforcast"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天是典型的逼宫行情，中石油破发，使得所有人觉得该干的事情给干了，但这种希望把管理层的政策弄出来的想法，显然有点太天真。"}, "正文字数": {"number": 1613}, "年份": {"number": 2008}}, {"标题": {"text": "多头版“半夜鸡叫”闹剧收场"}, "发布时间": {"date": "2008-04-21"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/midnightcockcrow"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "显然，周五的逼宫兵临3000点，给管理层足够的压力。但现在的管理层，有点葛朗台的味道。把自己兜里那点货都当宝贝了，总想用最小的代价把市场给打发了。因此，一个最没实质内容但又用“半夜鸡叫”模式过度包装的闹剧就此上演。"}, "正文字数": {"number": 488}, "年份": {"number": 2008}}, {"标题": {"text": "小分型顶起大反弹"}, "发布时间": {"date": "2008-04-22"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1193.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天，60分钟图上出现的小底分型顶出了一个大反弹，3085点的突破确认了分型的成立，后面就是回试能否站住最终形成向上笔的问题。"}, "正文字数": {"number": 332}, "年份": {"number": 2008}}, {"标题": {"text": "本ID的癌症在下午得到最权威的医学确认"}, "发布时间": {"date": "2008-04-22"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1194.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "其实，这东西对本ID没什么奇怪的，本ID一直都知道，但只是被好朋友们一致要求必须去进行全面检查，得到最权威的医学确认。"}, "正文字数": {"number": 417}, "年份": {"number": 2008}}, {"标题": {"text": "纯技术化的走势如期遭受3305点考验"}, "发布时间": {"date": "2008-04-23"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url"