[{"标题": {"text": "板块如期轮动"}, "发布时间": {"date": "2007-10-09"}, "主题": {"multi_select": ["板块与个股", "牛熊判断", "政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-929.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨晚已经说了“做空开始的时候，经常要比多头还要多头”，四处点火，那多头那点柴给烧没了，这就是做空程序的第一步。但多头不会一下死的，必须反复折腾，今天，在技术上，并不必然今天出现的一分钟中枢今天出现了，这对于空头的游戏，有了一个可依靠的平台。"}, "正文字数": {"number": 636}, "年份": {"number": 2007}}, {"标题": {"text": "房地产泡沫，经济发展的真正毒瘤"}, "发布时间": {"date": "2007-10-09"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-930.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "在经济发展中，希望不出现任何的泡沫，是不切实际的。泡沫是必然的，而泡沫破裂引发经济调整，也是经济发展的必然规律，这个阶段，从本质上是不可逃避的。但不可逃避的泡沫，亦有好坏之分。区分的标准就在于，是否最终影响到实体经济的深层结构与运行。通俗地说，股票市场的泡沫，属于好泡沫；而房地产市场的泡沫，就属于坏泡沫。股票市场，就算泡沫破裂了，但由于不是直接作用在实体经济层面，所以其影响是有限的；而房地产市场的泡沫一旦破灭，整个银行、金融体系就将受到最直接的冲击，其影响是灾难性的。"}, "正文字数": {"number": 1611}, "年份": {"number": 2007}}, {"标题": {"text": "空头，熊刀小试"}, "发布时间": {"date": "2007-10-10"}, "主题": {"multi_select": ["政策与基本面", "中枢结构", "板块与个股"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-931.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的回落，刚好触及140-143的1分钟中枢的震荡区域，但没有触及的中枢区域，因此，如果这下来的线段明天不继续延续，将构成一个类第三类买点，然后上去，再继续。这里有一个微妙的地方，今天留下这个线段不走完，就给明天的运作留下回旋的空间。一旦明天没有特别的东西，那么就继续上攻，继续吸精大法，毕竟多头的能量还在，让多头更快更强更高地套住，以后的杀跌动力才足够，这就举得越高，跌得越惨；如果明天就有足够的政策配合，那么这线段就直接杀下去，让那1分钟中枢扩展开来。"}, "正文字数": {"number": 791}, "年份": {"number": 2007}}, {"标题": {"text": "一个转帖"}, "发布时间": {"date": "2007-10-10"}, "主题": {"multi_select": ["政策与基本面", "板块与个股", "牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-932.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "当上证指数站上5000点，投资者一片欢呼之时，一篇不太\"和谐\"的文章--《市值远超GDP的虚胖与警示》在《第一财经日报》刊登后迅速在坊间热议。这篇文章的作者就是华生，燕京华侨大学校长。"}, "正文字数": {"number": 3285}, "年份": {"number": 2007}}, {"标题": {"text": "为让多头更高更快更强地替股票站岗而继续努力"}, "发布时间": {"date": "2007-10-11"}, "主题": {"multi_select": ["政策与基本面", "板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-933.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天已经超明确地说了：“一旦明天没有特别的东西，那么就继续上攻，继续吸精大法，毕竟多头的能量还在，让多头更快更强更高地套住，以后的杀跌动力才足够，这就举得越高，跌得越惨”，现在的方针，已经十分明确地说过，只要没政策，就沿着目前的速率，一直震荡攻击，把中字头搞得比八、九点的太阳还要太阳，指数比打了鸡血还要鸡血，但一般人，肯定赚不了一分钱，这就是分化的力量。"}, "正文字数": {"number": 857}, "年份": {"number": 2007}}, {"标题": {"text": "一团三战神"}, "发布时间": {"date": "2007-10-11"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-934.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "明天收盘就要去机场，晚上到后天下午，都有忙不完的事，不能发帖子了，明天的解盘，可能要周六晚上或周日才能补上，抱歉。"}, "正文字数": {"number": 614}, "年份": {"number": 2007}}, {"标题": {"text": "谨防A股被挟持，股指期货应缓行。"}, "发布时间": {"date": "2007-10-12"}, "主题": {"multi_select": ["板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-935.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "虽然已经被人多次引用，但依然不得不再次引用的事例，还是那令人无法忘怀的1995年国债期货悲剧。这一悲剧产生的因素太多，但有一点是不容忽视的，就是当时的国债现货流通量太小，几个机构联手，就足以控制相应期货的走势。至于最终形成两大集团对赌局面，那不过是这种控制走势分化演变的必然结果。"}, "正文字数": {"number": 1750}, "年份": {"number": 2007}}, {"标题": {"text": "刚忙完回酒店,就说上两句"}, "发布时间": {"date": "2007-10-13"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-936.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "经过一天半的冷静,如果还不能用脑子思考,那就去买国债吧,证明你完全没有自己操作股票的天分。剧本在周初就说过了，实际的走势，一直都是空头主控。今天的震荡，完成一个完美的板块切换，更重要的是，多头的心上，又挨上一刀。"}, "正文字数": {"number": 341}, "年份": {"number": 2007}}, {"标题": {"text": "终于要北大了"}, "发布时间": {"date": "2007-10-14"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-937.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "谜底揭开了就不是谜底了，终于要北大了，准确说，北大，终于有机会了。说这就足够了，该知道的时候总会时候的。"}, "正文字数": {"number": 226}, "年份": {"number": 2007}}, {"标题": {"text": "中国经济，已需治理整顿。"}, "发布时间": {"date": "2007-10-15"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-938.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "现在，中国经济已经到了一个关键的关口，由被动人民币升值带来的诸多问题已经逐步成为不能忽视的问题，而房地产泡沫也到了逐步不能被泡沫的程度。经济的过热，使得通货膨胀已成为一个可能需要面对的情况，这种情况下，是被经济的热度烧焦，还是冷静地进行反思，采取正确的选择，就是最近必须做出的抉择。"}, "正文字数": {"number": 388}, "年份": {"number": 2007}}, {"标题": {"text": "没有消息，继续把多头哨位架高"}, "发布时间": {"date": "2007-10-15"}, "主题": {"multi_select": ["政策与基本面", "板块与个股", "牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-939.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "显然，周末的准备金不会是空头所等待的那政策共振，周五大震荡配合的板块转换，其实已把空头的计划提前透露。上周，本ID已明确说，没消息，题材股会借机反弹走强，给中字头休息机会。这两天走势，不过是这剧本的现场演绎。看着这两天000777、600343、000600、000807、002149、000822等等的走势，以及这两天的涨幅榜中二、三线个股的大面积增多，这板块的反弹转换一目了然。但注意，除了个别最近有实质题材的，题材股大多目前不具备大幅度启动的时机，只是一种换档式的过渡。"}, "正文字数": {"number": 1249}, "年份": {"number": 2007}}, {"标题": {"text": "成老先生，请慎言"}, "发布时间": {"date": "2007-10-16"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-940.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "投机，不过是一种市场行为，对市场无所谓好坏，而且，市场充满骗线，例如，以前，某股票，短时间内暴涨100%，然后连续跌停，最终跌到0，给摘掉了，所有为那100%兴奋的，结果发现，即使按那100%的起点算起来，也是一个高高的山顶。前面那100%的做多，不过是总体做空的一部分程序，这就如同目前的大盘，正在赶顶之中，这时候宣扬投机，难道是一个合适的时间？"}, "正文字数": {"number": 906}, "年份": {"number": 2007}}, {"标题": {"text": "6100点终破，无憾矣！"}, "发布时间": {"date": "2007-10-16"}, "主题": {"multi_select": ["牛熊判断", "板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-941.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的大盘，延续上周说的大震荡后的中字头休息、题材股启动。今天糖业大启动，600737不大动，主要是现在，中国最大的糖产还没装进来，今天跟着启动，似乎有点名不正。不过，该股最牛的题材，还不是将有最大的糖，而是其他，这类中长线的股票，短线的走势并不重要。就像000777，从去年12月的7元多到现在的47元多，真正的题材还没出来，这就是中长线股票的走法。"}, "正文字数": {"number": 875}, "年份": {"number": 2007}}, {"标题": {"text": "确实存在全面泡沫化的潜在风险"}, "发布时间": {"date": "2007-10-17"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-942.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "现在，确实存在全面泡沫化的倾向。一旦全面泡沫破裂，那调整的时间将极为长。目前，如果市场能进行中期的休整，有利的是市场行情的长期发展。所以，本ID已经明确说了，如果11月前后的政策之窗不打开，就展开低价革命，那多头最后的精气神给耗尽，然后就是第一阶段的结束，该怎么死就怎么死。但如果11月份前后的政策之窗适时打开，那么大牛市的第一阶段还没完，将能延续更长的时间。"}, "正文字数": {"number": 634}, "年份": {"number": 2007}}, {"标题": {"text": "解盘兼北京旅游指南，为奥运贡献一把"}, "发布时间": {"date": "2007-10-17"}, "主题": {"multi_select": ["中枢结构", "大盘解盘"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/stocks/beijingtravelguide"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "对不起，刚回家。今天大盘，继续6124下来的中枢震荡，技术上，能否震荡出5分钟中枢，明天就有分晓，然后就是该中枢的第三类买卖点问题。现在，无论怎么走，都没太大意义，关键是会议结束后基本面的进展速度，这决定该冲顶游戏的结束时间。"}, "正文字数": {"number": 577}, "年份": {"number": 2007}}, {"标题": {"text": "不费吹灰之力，空头完胜"}, "发布时间": {"date": "2007-10-18"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-944.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID说过，本ID有一个情结，就是6100点，过了，情结就了了。如果这波大盘真给顶出顶来了，最好不过的点位就是6124.04点，这比6144.44、6124.44点都好。当然，空头从来都是很谦虚的，并没觉得这顶就一定完成顶成，但空头这次的冲顶游戏中，占尽先机，现在，又回到前两次盘中实验跳水的地方，空头已经完全掌握主动，上下自如了。上，大不了再玩一次这几天的游戏；下，那更是空头的拿手好戏，就等着政策配合一下了。"}, "正文字数": {"number": 938}, "年份": {"number": 2007}}, {"标题": {"text": "对不起，刚回来"}, "发布时间": {"date": "2007-10-18"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-945.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "对不起，刚回来。下午、晚上，分别二个关于商业的无聊会面，但今晚的意义不在这上，9点后赶了第三场，一个小聚会，一朋友明天要飞降南方某省去扑火，其事起因，简直比所有滑稽笑话还要笑话，笑话之后，骨头都冰凉，我的中国，哎。"}, "正文字数": {"number": 277}, "年份": {"number": 2007}}, {"标题": {"text": "多头，没种，有屁用！"}, "发布时间": {"date": "2007-10-19"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-946.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "技术上，昨天说得很清楚，就是5800点的1分钟震荡，这震荡形成后，就看其第三买卖点的问题了。"}, "正文字数": {"number": 1029}, "年份": {"number": 2007}}, {"标题": {"text": "教你打坐12：如何呼吸"}, "发布时间": {"date": "2007-10-20"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-947.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "生死，就在一呼一吸间，呼吸问题不解决，谈什么生死问题，都是口头缠。呼吸，谁都会，不会的，早死了。但实际上，真正会呼吸的，并不多见。"}, "正文字数": {"number": 1715}, "年份": {"number": 2007}}, {"标题": {"text": "北京旅游指南三：京秋红叶"}, "发布时间": {"date": "2007-10-21"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-948.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "秋天，北京最好的季节，现在到了最黄金的时段。香山那边的红叶，名是有了，却太闹，远不如诸多无名山岭的红叶来得天真有趣。写首五古，也给现在来不了北京的朋友指南指南。"}, "正文字数": {"number": 162}, "年份": {"number": 2007}}, {"标题": {"text": "让今天要拉大阳的多头见鬼去"}, "发布时间": {"date": "2007-10-22"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-949.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "从6124.04这样一个绝妙的点位开始的1分钟下跌走势，在中枢的不断下移中延续着，现在刚好收在3600点上来的上升通道下轨上，而那5600点的缺口，就在眼前，一旦这个地方有效跌破，这针对从3600点开始上升行情的调整就得以确认。"}, "正文字数": {"number": 828}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票85：逗庄家玩的一些杂史3"}, "发布时间": {"date": "2007-10-22"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-950.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "大盘的顶部和个股的顶部不同，要复杂得多，因为集中其中的分力更多，所以其合力当然要更复杂。一般来说，大盘的顶部都不会是简单的图形，都是十分复杂。而且即使真的形成，最后破位前反而要有很多的犹豫，越大型的顶部越是这样。"}, "正文字数": {"number": 2123}, "年份": {"number": 2007}}, {"标题": {"text": "上升通道下轨支持如期反弹"}, "发布时间": {"date": "2007-10-23"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-951.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说得很清楚，1分钟下跌底背驰后，一轮反弹将展开。今天的技术走势十分标准，更重要的是，这里是3600点上来的上升通道下轨位置，又是缺口位置，因此技术上必须要有这次反弹。"}, "正文字数": {"number": 895}, "年份": {"number": 2007}}, {"标题": {"text": "太累了，没时间写帖子，说两句闲话"}, "发布时间": {"date": "2007-10-23"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-952.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本来是可以写帖子的，结果晚上谈事回来，看到下面搞的合同，几乎把本ID看晕了，完全不是本ID的意思。本ID只好浪费不少时间，等于重写一遍合同，这种事还要亲自干，真是晕。"}, "正文字数": {"number": 571}, "年份": {"number": 2007}}, {"标题": {"text": "10日线如期阻截"}, "发布时间": {"date": "2007-10-24"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-953.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天明确说了，看5、10日线，今天，10日线的阻截明显。不过，由于今天在该线下形成一个1分钟中枢，因此短线走势，就看这1分钟中枢的第三类买卖点情况。如果能有第三类买点，那么将再次冲击6000点。"}, "正文字数": {"number": 577}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票86：走势分析中必须杜绝一根筋思维"}, "发布时间": {"date": "2007-10-24"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-954.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "一个很简单的实验，同一批人，同样的资金，同样的股本、同时开始股票运行的实验，显然，这个实验是不可重复的。因为，股票走势，归根结底，是参与者心理合力的痕迹，而心理，是不可重复的。否则，请问，有谁能百分百复制自己9月30日开盘那四小时的心理曲线？这都是一次性的，不可复制。而几千万、上亿人的交易的可复制性，就更没可能了。为什么？每天都是新世界，影响市场的因素，每天都在变化着，而这些因素对市场参与者的心理影响，更是模糊、混沌，由此产生的走势，很显然不具有任何百分百复制的可能性。"}, "正文字数": {"number": 3915}, "年份": {"number": 2007}}, {"标题": {"text": "终于再次强调宏观调控，中国希望大大的。"}, "发布时间": {"date": "2007-10-25"}, "主题": {"multi_select": ["比例线与点位", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-955.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "技术上，昨天已经把可能的情况进行最严密的分析，就是看那1分钟中枢的第三类买卖点情况，今天早上受消息影响低开后，第一小时的反抽刚好构成第三类卖点，这就是本ID理论规范下，短线最后的逃命线，"}, "正文字数": {"number": 809}, "年份": {"number": 2007}}, {"标题": {"text": "中国经济和股市的未来依然美好"}, "发布时间": {"date": "2007-10-25"}, "主题": {"multi_select": ["牛熊判断", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-956.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "对年末的走势，本ID早有总体的分析。在“2007年末，资金与政策博弈下的走势分析 2007-09-17 00:41:48”里，已经对走势给出最明确的分析，本ID后面的所有判断与行为，都在9月17日把剧本公布了，6100点，在这帖子里明确分析过了，但有多少人能留意？大概都被每天的波动所消磨掉了。"}, "正文字数": {"number": 1756}, "年份": {"number": 2007}}, {"标题": {"text": "5555点守住，反弹酝酿ing"}, "发布时间": {"date": "2007-10-26"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-957.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "由于股指期货、中石油等的预期，所以中字头依然在反弹中继续扮演最重要的角色，而一些跌到重要均线位置的题材股，也会有一定的表现，但将趋于个股，板块效应不大。"}, "正文字数": {"number": 405}, "年份": {"number": 2007}}, {"标题": {"text": "今天不得不破例说股票"}, "发布时间": {"date": "2007-10-27"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-958.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "虽然道理上，那地方不是随便可以住的，但其实，只要认识门道，确实可以很随便就入住，特别今天开那所谓衍生品大会的地方。那地方今天就这么把股指期货如此地随便了一下，难道就为了里面那些别的最高档酒店也没有的古董玩意？"}, "正文字数": {"number": 823}, "年份": {"number": 2007}}, {"标题": {"text": "摸着石头过河辨"}, "发布时间": {"date": "2007-10-28"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-959.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "“摸着石头过河”，已经成为一些无聊人的口头禅，甚至是为自身愚昧而导致无聊行为的托词。但这话，从来不是放之四海而皆准的真理，对于现在，还特别有害。"}, "正文字数": {"number": 1285}, "年份": {"number": 2007}}, {"标题": {"text": "明天面临下降通道上轨压力"}, "发布时间": {"date": "2007-10-29"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-960.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "5555点站稳后反弹，这都在预计之中早说了，明天面临下降通道上轨压力，这是技术的话，基本面上，如果指数期货出来，点位根本没意义，特别在形成多空对赌的局面时，那时候，只需要关于如何把对方打爆了，什么点位不点位的，如果夹到100000点才能把空头夹死，那当然也是可以这样操作的。"}, "正文字数": {"number": 531}, "年份": {"number": 2007}}, {"标题": {"text": "那一夜，他的体液喷了我一身（二十四）"}, "发布时间": {"date": "2007-10-29"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-961.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "“现在还很难说这衣裳给谁的，千科、千通、珠河、单天都在折腾着。战白和短虚更好玩，自家打起来了。不过有咱，他们都没戏。”"}, "正文字数": {"number": 892}, "年份": {"number": 2007}}, {"标题": {"text": "突破上轨，反弹空间如期打开。"}, "发布时间": {"date": "2007-10-30"}, "主题": {"multi_select": ["中枢结构", "牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-962.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说了，突破下降通道上轨后，反弹空间打开。今天走势极端规范，下午那次跳水，就是对上轨突破后的回抽，这些最基本的技术语言，如果都看不明白，就必须补课了。"}, "正文字数": {"number": 1222}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票87：逗庄家玩的一些杂史4"}, "发布时间": {"date": "2007-10-30"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-963.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "前面说了做顶出货的，今天说说做底吃货的。准确说，如果是吸货，无所谓底部。只要有筹码有钱有足够的时间，什么成本拿的货，其实都可以摊下来的。特别是那些对走势有足够影响的分力，后面各级别的顶是自己的、底也是自己的，差价都是自己的，什么成本不能下来？"}, "正文字数": {"number": 1991}, "年份": {"number": 2007}}, {"标题": {"text": "1分钟中枢如期形成ing"}, "发布时间": {"date": "2007-10-31"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-964.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说了，关键看新的1分钟中枢位置，今天，这中枢依然没形成，当然，只要明天有所回落，这中枢就形成了，一旦中枢形成，后面就是第三类买卖点的问题，一个超简单的问题，就不用多说了。"}, "正文字数": {"number": 531}, "年份": {"number": 2007}}, {"标题": {"text": "借点酒力，来首七律：即事"}, "发布时间": {"date": "2007-10-31"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-965.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "即事 缠中说禅 无端生死入娑婆八角磨盘自转磨天局皆如人局幻醒时犹作醉时疴百年风雨茶三碗万古文章梦一箩海上浮云忽乱起尘寰又舞几神魔"}, "正文字数": {"number": 101}, "年份": {"number": 2007}}, {"标题": {"text": "震荡等待中石油"}, "发布时间": {"date": "2007-11-01"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-966.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的走势极端教科书，早上背驰后形成1分钟中枢的第二段，然后回跌构成第三段，这样1分钟的中枢就构成了，紧接着就是围绕这个中枢的震荡，下面需要等待的只是第三类买卖点问题。"}, "正文字数": {"number": 589}, "年份": {"number": 2007}}, {"标题": {"text": "教你打坐13：何谓四大"}, "发布时间": {"date": "2007-11-01"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-967.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "刚回酒店，打开电视，就听到一清华的垃圾教授说“四大皆空”的“四大”是指东南西北。清华，也就是这水平了，原谅他吧。"}, "正文字数": {"number": 783}, "年份": {"number": 2007}}, {"标题": {"text": "调整形态保持，震荡级别加大"}, "发布时间": {"date": "2007-11-02"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-968.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的走势同样极为教科书，因此，复制了图，可以认真研究一下。针对189-192的1分钟中枢，195是第三类卖点，但对于191开始的线段类下跌，194-195是第二个类中枢，所以后面的跌破，力度不够，出现明显背驰，然后就必然要在这个位置出现一个新的1分钟中枢。"}, "正文字数": {"number": 788}, "年份": {"number": 2007}}, {"标题": {"text": "教你打坐14：世界与四大"}, "发布时间": {"date": "2007-11-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-969.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "由于一般人、包括科学，多被业报、共业所造的六识境界所困，所以无论对人身或者宇宙的认识，都是极端狭隘的。"}, "正文字数": {"number": 838}, "年份": {"number": 2007}}, {"标题": {"text": "教你打坐15：人体与四大"}, "发布时间": {"date": "2007-11-04"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-970.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "至于火大、水大、风大，如果用得好，对于人体对应的状态级别来说，都是一种提升的力量。当然，这种提升，只是针对人体的欲界级别来说，如果对于色界的众生来说，这些都是下降、毁灭的力量。"}, "正文字数": {"number": 3240}, "年份": {"number": 2007}}, {"标题": {"text": "宠爱之便宜且昂贵的中石油"}, "发布时间": {"date": "2007-11-05"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-971.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天大盘走成什么样子，其实都没意义。今天有什么消息，其实也没太大意义。因为有了中石油，一切都没意义了。为什么？你看看中石油的市值，等于中石头加工行、中行还要大，以后的指数，极大地相关于中石油的走势，站在指数的角度，拥有中石油，就拥有一切的控制力。"}, "正文字数": {"number": 1009}, "年份": {"number": 2007}}, {"标题": {"text": "说说大盘中期走势的演化"}, "发布时间": {"date": "2007-11-06"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-972.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本来想写课程的，现在也没时间了，就说说大盘的中期走势。这，本ID其实已经反复说了。只是总结着说一次，让各位更加明确点，免得被行情又给折腾糊涂了。"}, "正文字数": {"number": 1031}, "年份": {"number": 2007}}, {"标题": {"text": "5555点争夺战"}, "发布时间": {"date": "2007-11-06"}, "主题": {"multi_select": ["中枢结构", "比例线与点位"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-973.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的走势，就是一个5555点争夺战，一般这样的战斗，胜负至少看3天，上下还有一个3%的缓冲区域，5555X97%是多少，自己去算吧。"}, "正文字数": {"number": 1066}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票88：图形生长的一个具体案例"}, "发布时间": {"date": "2007-11-06"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-974.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID的理论，对所有的走势，进行了一个最明确的分解，所有的分解，本质上只有两类，就是延续与转折，用残酷一点的词语，就是生和死。"}, "正文字数": {"number": 2897}, "年份": {"number": 2007}}, {"标题": {"text": "5555点决战即将进入临界点"}, "发布时间": {"date": "2007-11-07"}, "主题": {"multi_select": ["中枢结构", "均线系统"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-975.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这个题目有点名不副实，因为这决战，对于空头来说，只是小战役，结果并不重要；但对于多头来说，就是决定生死存亡的。从6124点开始的行情转折中阴阶段，对于多头是垂死挣扎一下，还是干脆破罐子破摔，早死早投胎，很快，准确地说，最迟下周一前后就有答案了。"}, "正文字数": {"number": 1479}, "年份": {"number": 2007}}, {"标题": {"text": "血凝心裂，苍天啊！"}, "发布时间": {"date": "2007-11-07"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-976.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "有些事情，真是不该知道，知道了，只能让人绝望。注意，本ID可不是说股票，股票算什么？"}, "正文字数": {"number": 188}, "年份": {"number": 2007}}, {"标题": {"text": "历史将为林彪元帅平反"}, "发布时间": {"date": "2007-11-08"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-977.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这个问题，已经说过多次，不过还是要说。正如本ID给林彪元帅所写的七律里，颈联“曾经百战喧天地，一夜孤行惑古今”。前一句，就不用说了，任何没有偏见的人都承认，而后一句，似乎没有疑问了，似乎太常识了，但这“惑”，应该不会永远的。"}, "正文字数": {"number": 465}, "年份": {"number": 2007}}, {"标题": {"text": "如期决战，多头不堪一击"}, "发布时间": {"date": "2007-11-08"}, "主题": {"multi_select": ["均线系统"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-978.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说，决战进入临界点，最迟周一有结果。结果是，多头如此不堪一击，太令人失望了。这证明了本ID的一个断言：空头是心急的。而昨天，本ID给多头编的5月均线大埋伏剧本，是否如本ID所担心的那样：“这些蠢蠢的多头，估计抄也抄不成样子，最后，可能还是要和5月均线吻别于狂乱的夜”，很快也有答案了。"}, "正文字数": {"number": 1184}, "年份": {"number": 2007}}, {"标题": {"text": "5月均线大埋伏剧本如期上演"}, "发布时间": {"date": "2007-11-09"}, "主题": {"multi_select": ["均线系统", "中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-979.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天行情没什么可说的，就本ID前两天已经公布的5月均线大埋伏剧本的现场版。不过，说老实话，同样的剧本，不同的导演，效果当然是不同。今天这种演出水平，显然不是太令人满意的，所以本ID一早就给了一个定性：“这些蠢蠢的多头，估计抄也抄不成样子”，至于是否会“最后，可能还是要和5月均线吻别于狂乱的夜”，很快也会有答案了。"}, "正文字数": {"number": 1087}, "年份": {"number": 2007}}, {"标题": {"text": "教你打坐16：意识与四大"}, "发布时间": {"date": "2007-11-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-980.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "在唯物、唯心蠢人的眼里，意识与四大是沾不上边的。在他们那里，四大是物质，意识是精神。然后是物质决定意识还是意识决定物质，这一性那一性地就哲学基本问题了。"}, "正文字数": {"number": 1464}, "年份": {"number": 2007}}, {"标题": {"text": "略论国家经济意志的市场化体现"}, "发布时间": {"date": "2007-11-11"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-981.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "目前，单单从具体资产的实际运用上看，国有股份，已经是股市中最大的绝对控制力量，目前的指数，已经完全是中字头股票的天下；而社保基金，最终将在国有股份划转、减持与最终运作中扮演极为重要的角色；而中投公司的成立，使得外汇储备的应用在内外资本市场中的协同性与隐含的战略性至少有了超越波段性质的重要意义。"}, "正文字数": {"number": 1314}, "年份": {"number": 2007}}, {"标题": {"text": "1000点小康跌幅胜利完成"}, "发布时间": {"date": "2007-11-12"}, "主题": {"multi_select": ["中枢结构", "均线系统", "比例线与点位"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-982.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天，5月均线大埋伏剧本继续演绎，今天的利空，刚好为6004点下来的1分钟下跌构成底背驰做出最后的贡献。本ID已经早说了，6004点下来的1分钟下跌一旦背驰，会出现较大级别反弹。现在，5月均线大埋伏剧本与1分钟下跌背驰剧本最终两剧合一。"}, "正文字数": {"number": 1670}, "年份": {"number": 2007}}, {"标题": {"text": "市场总是少数人成功"}, "发布时间": {"date": "2007-11-13"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-983.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "按照市场的节奏，6004点跑掉的，昨天开始回补闹一闹反弹，反弹一旦结束，就砸出去，没什么可犹豫的。图形告诉你一切，反弹是否结束，一切尽在走势中。"}, "正文字数": {"number": 805}, "年份": {"number": 2007}}, {"标题": {"text": "5日线受阻，多头仍需努力。"}, "发布时间": {"date": "2007-11-13"}, "主题": {"multi_select": ["均线系统", "牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-984.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天反弹受阻5日线,这是最简单的走势,按本ID的理论,分型成立后是否能延伸为笔,关键是看5日线,只要不能重上,那么这个底分型就有破坏的可能。当然，一般这底分型即使真的被破坏，也会在不远处形成新的能最终形成笔的底分型，所以，多头还是有短线希望的，只是过程可能有点多灾多难，例如，今天中午传出的CPI，就给早上的多头泼了凉水。"}, "正文字数": {"number": 501}, "年份": {"number": 2007}}, {"标题": {"text": "节奏爽了才是真的爽"}, "发布时间": {"date": "2007-11-14"}, "主题": {"multi_select": ["中枢结构", "均线系统"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-985.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说得很明确，就是看5日线，因为昨天刚好构成底分型，所以今天下午一站上5日线，大盘就强烈启动起来，这都是极端教科书的走法，自己好好体会吧。"}, "正文字数": {"number": 991}, "年份": {"number": 2007}}, {"标题": {"text": "对不起，解盘晚了。"}, "发布时间": {"date": "2007-11-15"}, "主题": {"multi_select": ["大盘解盘"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-986.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "对不起，解盘晚了。今天一收盘，就给抓去看企业，书记亲自出面,你说有什么办法?来到下面，个个人都急着，把你当点石成金的圣手，苦呀，没办法，各位也请原谅。"}, "正文字数": {"number": 610}, "年份": {"number": 2007}}, {"标题": {"text": "多头，不要争当中关村的货。"}, "发布时间": {"date": "2007-11-16"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-987.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "市场继续在这里折腾，这个5分钟的中枢震荡，将继续向更大级别延伸，因此，最终的突破方向，其级别意义就更大了，暂时，估计还需要一定的时间。"}, "正文字数": {"number": 416}, "年份": {"number": 2007}}, {"标题": {"text": "酒醒步“牛、流、秋、愁”韵成五律六首"}, "发布时间": {"date": "2007-11-17"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-988.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "酒醒步“牛、流、秋、愁”韵成五律六首 缠中说禅 一 吸尽西江酒长歌摧斗牛裂云天地枕日月掌中流光影澄波起鱼迷碧海秋萧萧风雨夜醒醉古今愁 二 恍惚凌霄汉扶摇攀斗牛天风六龙散海气万星流窗入楚山晓门开湘水秋短诗消宿酒残梦酿新愁 三 风云多虎豹奔走几羊牛天地孤身立兴亡双泪流民兮心欲晓国矣鬓先秋漫漫何修远独担江海愁 四 不辩红黄白全称风马牛狼羊同代表清浊共潮流尽舞中天日谁观一叶秋古今多少事梦破只余愁 五 慎对千夫指存疑孺子牛龙蛇无异穴泾渭可同流东海黄非雨西山红岂秋神言九门挂鬼哭九天愁 六 庖丁今技拙举世解金牛无品可商品入流皆物流尽如情一夜何必业千秋张衡徒费事痴心赋四愁"}, "正文字数": {"number": 322}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票89：中阴阶段的具体分析"}, "发布时间": {"date": "2007-11-18"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-989.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "中阴阶段能否处理好，关系到操作节奏的连接问题。很多人的操作节奏特乱，就是因为不知道中阴阶段的问题。中阴阶段，虽然表现为中枢震荡，但并不是一般性的中枢震荡。"}, "正文字数": {"number": 2531}, "年份": {"number": 2007}}, {"标题": {"text": "阶级斗争，打土豪分田地。"}, "发布时间": {"date": "2007-11-19"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-990.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "技术上，大盘的5分钟震荡依然，所以，继续按中枢震荡的规矩操作就可以，当然，现在指数的意义不断下降，所以可以根据具体板块的图形决定操作。"}, "正文字数": {"number": 919}, "年份": {"number": 2007}}, {"标题": {"text": "《货币战争和人民币战略》续七：和谐世界存在的N种可能"}, "发布时间": {"date": "2007-11-20"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-991.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "注意，所有上面的条件都同时成立，大概能构成一个和谐世界存在的可能。除此之外，几无任何可能。甚至，以后科学昌明，发明一种和谐世界试剂，人人生下来都先打一针，也有例外，药力失效、基因变异等等最终破坏和谐世界的可能。所以，要和谐世界，也只有上面这种可能了。"}, "正文字数": {"number": 1490}, "年份": {"number": 2007}}, {"标题": {"text": "快点解盘，否则要爽约。"}, "发布时间": {"date": "2007-11-20"}, "主题": {"multi_select": ["中枢结构", "大盘解盘"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-992.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的大盘，依然在中阴状态中无方向地震荡，这是一个中阴状态中的常态，目前，这个5分钟的中枢震荡继续维持，如果继续下去，就会延伸出30分钟。抬头刚好看到有点不太圆的月亮，月圆的时候，这中枢震荡是否能结束呢？"}, "正文字数": {"number": 1099}, "年份": {"number": 2007}}, {"标题": {"text": "管理层终于又做对了一次"}, "发布时间": {"date": "2007-11-21"}, "主题": {"multi_select": ["板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-993.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天，最重要的消息，就是关于AH股上市顺序的问题，今天这个比较官方的表述证明，A股的重要性再次得到加强，以后港股被吸收进来的命运是不可逆转了，只是时间长短的问题。更重要的是，本IDN个月来到处大声呼吁要大幅度提高A股大盘流通比例终于有了一个切实的解决。以后的问题就是，新发行的大盘股，一定要达到流通比例10%的底线，前面这些投机性蓝筹，将不会再出现。"}, "正文字数": {"number": 834}, "年份": {"number": 2007}}, {"标题": {"text": "和谐世界的真义"}, "发布时间": {"date": "2007-11-21"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-994.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "晕，下午到现在，竟然谈了三拨人，本ID现在真有点喜欢和新认识的人谈判。本ID发现，从419的角度，本ID这段时间谈过的这么多人，竟然没有一个能让人眼前稍微提高点亮度的，是不是搞企业的人都属于歪瓜裂枣型的？"}, "正文字数": {"number": 1121}, "年份": {"number": 2007}}, {"标题": {"text": "又是月亮惹的祸"}, "发布时间": {"date": "2007-11-22"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-995.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "当然，站在纯技术的角度，虽然小的1分钟级别的第三类卖点早上就有了，但目前的破位是否能形成大的5分钟第三类卖点，还是一个未知的事。所以，多头目前也不是完全没机会，面包还是有的，就看能不能把中枢扩展成30分钟的，这样，后面的下跌，不过是一个陷阱。"}, "正文字数": {"number": 968}, "年份": {"number": 2007}}, {"标题": {"text": "过高的股票交易印花税已到必须调整时"}, "发布时间": {"date": "2007-11-22"}, "主题": {"multi_select": ["政策与基本面", "板块与个股"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-996.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "可以说，蓝筹流通比例过低的问题一旦解决，将使得市场的运行结构有了一个合理的基础。如果最重要的A股都没有一个合理的运行结构基础，那么多层次资本市场的建构基础合理就更谈不上了。在某种意义上，该问题的解决是股权分置改革的一个深化过程，极为重要。不过，这里又有一个遗留问题产生，就是这些已上市的流通比例不足的疑似非法蓝筹如何达标必须限时解决，否则将使得这些品种成为稀缺资源，在指数期货推出后埋下严重投机的巨大隐患。"}, "正文字数": {"number": 1731}, "年份": {"number": 2007}}, {"标题": {"text": "对不起"}, "发布时间": {"date": "2007-11-23"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-997.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "对不起，刚接电话，内蒙来接本ID的车已经到了，本ID一收盘就要走，否则那边晚宴等着，不好意思。"}, "正文字数": {"number": 83}, "年份": {"number": 2007}}, {"标题": {"text": "对不起，晚到的解盘"}, "发布时间": {"date": "2007-11-25"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-998.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "前面说了，在120天线附近，最坏情况也肯定有至少一次对5000点的反抽，大盘周五走势其实就来自演绎这剧本。问题在于，给多头最后一次机会，多头能否给点勇气，依靠120天线站住5000点，下周就要分晓。"}, "正文字数": {"number": 659}, "年份": {"number": 2007}}, {"标题": {"text": "抱歉，刚回家，还要忙。"}, "发布时间": {"date": "2007-11-26"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-999.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "股市同样是一个丛林，同样有着最伟大的丛林法则，就是这么血腥，怎么了？中石油，就要无耻地继续类中国人寿的走势。多头，站不上5163点，就是要被强暴地打击，没什么可讨论的，也没有可同情的。"}, "正文字数": {"number": 679}, "年份": {"number": 2007}}, {"标题": {"text": "时间错乱还有两天，抱歉了。"}, "发布时间": {"date": "2007-11-27"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1000.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的大盘，走得没什么可说的，5160点上不去后的延续性走势而已。站在周K线角度，因为本周肯定新低了，所以这周K线肯定完成不了底分型的构造。站在周线角度，只要5周线不能重新站住，基本可以不看这个盘了，爱跌到多少都行。"}, "正文字数": {"number": 656}, "年份": {"number": 2007}}, {"标题": {"text": "大盘进入基本支持区域"}, "发布时间": {"date": "2007-11-28"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1001.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "大盘今天继续无精打采的，不过大盘确实已经进入一个基本的支持区域。首先，按双顶的量幅，也基本到位了；其次，周线上一个从2005年开始从来没有跌破的支持线也在不远处，下月开始，10月线也会上移到附近区间，诸如此类的支持因数都在加强。"}, "正文字数": {"number": 683}, "年份": {"number": 2007}}, {"标题": {"text": "120天支持终显威力"}, "发布时间": {"date": "2007-11-29"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1002.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "大盘的走势，不太错乱。本ID在前面说了，跌破5000点，只是一个空头陷阱，而120天线有基本支持，即使继续下跌，也不过是继续构造空头陷阱。今天大盘拉回5000点之上，使得一个更大级别的中枢在扩展开来。也就是说，5000点上下，将扩展出30分钟的中枢，后面的走势，就可以用这30分钟震荡的观点来观察，当然，如果这30分钟竟然震荡出第三类卖点，那么全面小康、初步富裕都不是什么奇怪的事情。这里无须预测什么，只要看好这震荡就可以把握了。"}, "正文字数": {"number": 788}, "年份": {"number": 2007}}, {"标题": {"text": "周末继续效应"}, "发布时间": {"date": "2007-11-30"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1003.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的大盘同样正常，也就是继续周末效应。大的走势上，继续是5000上下的震荡。下周，反复强调的10月线上移，而5周线下移，因此，这构成大盘震荡的两个夹板。所谓夹板，就是上破是多头陷阱，下破是空头陷阱，总之，到处是陷阱，多头空头都没好日子过。"}, "正文字数": {"number": 832}, "年份": {"number": 2007}}, {"标题": {"text": "人生之残酷"}, "发布时间": {"date": "2007-12-01"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1004.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "能生为人的，无非两种：一种是乘愿而来的；一种是被业力驱使而来的。第一种就无所谓讨论了，非一般人的境界；绝大多数的人，都属于第二种。"}, "正文字数": {"number": 1435}, "年份": {"number": 2007}}, {"标题": {"text": "教你打坐17：何谓打坐"}, "发布时间": {"date": "2007-12-02"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1005.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "对于第一种，编写佛教大词典、哲学小丛书的，不过是在各种意识形态游戏中混饭吃的可怜虫，这种人，当书虫都级别太低，吃他们的垃圾货的，能是什么货色呢？对于第二种，因为无明执着，困于不同境界而不自知，终成画饼；对于第三种，与科学同落六识之陷阱，划地自牢；第四种，这里的名人名师不少，最能蛊惑人，不过是自造恶业而已；第五种，有所得者皆妄，偷心不死，永无出期。"}, "正文字数": {"number": 1574}, "年份": {"number": 2007}}, {"标题": {"text": "短线面临变盘"}, "发布时间": {"date": "2007-12-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1006.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "其实，站在个股方面，很多个股已经反抽不少了，指数走成这样，都是神油在做怪。不过那油也快破30了，第一基本目标也基本达到，唯一有变数的只是是否要破一下30恐吓一下最后的不坚定分子，这就对应了大盘是否要再走一空头陷阱的选择。"}, "正文字数": {"number": 635}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票90：中阴阶段结束时间的辅助判断"}, "发布时间": {"date": "2007-12-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1007.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "注意，这里给出的是中阴阶段结束时间的辅助判断，并不是一个绝对性的判断，如同用MACD判断背驰一样，只是一个辅助性，但由于准确率极高，绝对的判断反而因为太复杂而不实用，所以就可以一般性地利用这进行判断。一般来说，这个中阴阶段结束时间的辅助判断的有效性可以达到接近100%，很少有例外。"}, "正文字数": {"number": 1331}, "年份": {"number": 2007}}, {"标题": {"text": "突破回抽，明后是关键"}, "发布时间": {"date": "2007-12-04"}, "主题": {"multi_select": ["大盘解盘"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1008.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天大盘略微发了点力，突破6004点下来的下降通道上轨，但受阻于10日线，不过其后的回落并没有跌回上轨之下，因此，暂时还是一个可接受的局面。一般来说，突破后需要3天确认，因此明后就是关键了。"}, "正文字数": {"number": 654}, "年份": {"number": 2007}}, {"标题": {"text": "歌唱技术（二）"}, "发布时间": {"date": "2007-12-04"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1009.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这两天心情大好，不妨和各位风花雪月一番，再谈谈歌唱的技术问题。顺便说一句，本ID原来那音乐播客所在地方估计是彻底倒闭了，原来上传的音乐全部被洗劫，本ID现在心情好，找时间把这音乐播客要投胎再来，究竟有什么投胎的好去处，各位请建议一下，本ID比较懒，最好是和原来那个一样，有专门的播放器，可以自动上传音乐的，并且能把音乐的播放转到这里来的。其实，新浪早该搞一个了，技术上应该不是太难的事情。"}, "正文字数": {"number": 1337}, "年份": {"number": 2007}}, {"标题": {"text": "长阳突破10日线，大反抽确立。"}, "发布时间": {"date": "2007-12-05"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1010.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "不过，现在这反抽刚确认，我们还是先探讨这反抽本身的问题。昨天明确说了“大盘大反抽的最终确立，以10日线的站稳为标志。”今天早上前30分钟，这10日线就被攻克了，然后后面的上涨，就是顺理成章的事情了。"}, "正文字数": {"number": 840}, "年份": {"number": 2007}}, {"标题": {"text": "那一夜，他的体液喷了我一身（二十五、二十六、二十七）"}, "发布时间": {"date": "2007-12-05"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1011.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "在没有了太监的日子里，中官村成了中关村，到处布朗运动着因改革开放摸着石头过河不管白猫黑猫能抓耗子就是好猫而来自五湖四海神州大地有几只苍蝇嗡嗡乱叫小小寰球这里很危险快点回去火星疑是庐山瀑布错挂地方每年招惹百来只鹊儿乱搭豆腐渣工程只供一对狗男女野合的窄窄水沟广义相对论宇宙方程着大爆炸了忽悠住上下四方古往今来各色号称比太监多了点物事的某性物体。"}, "正文字数": {"number": 971}, "年份": {"number": 2007}}, {"标题": {"text": "5010点的回抽确认"}, "发布时间": {"date": "2007-12-06"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1012.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天按昨天所说的，全天就是对5010点的回抽确认。其实，如果心思缜密的，就知道，今天下午突然下破5010点的走势，就是一个典型的小空头陷阱。"}, "正文字数": {"number": 685}, "年份": {"number": 2007}}, {"标题": {"text": "一场酒，一场恨。"}, "发布时间": {"date": "2007-12-06"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1013.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "又喝了老多，和几个某方面的老前辈在一起，边喝边聊，说些老皇历，越说越有气，本ID从来不会为自己的得失生气，但一想到某些地方，想到某些人的蠢行造成的后果，就火大。"}, "正文字数": {"number": 318}, "年份": {"number": 2007}}, {"标题": {"text": "5010点站稳，行情继续展开"}, "发布时间": {"date": "2007-12-07"}, "主题": {"multi_select": ["板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1014.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天真没什么可说的，早上再次回试5010点，结果在5021点就被拉起，而且还是在周五，说明市场心态还是比较反弹行情的继续展开的，其后的走势，就是理所当然的事情了。"}, "正文字数": {"number": 494}, "年份": {"number": 2007}}, {"标题": {"text": "5010点站稳，行情继续展开。"}, "发布时间": {"date": "2007-12-07"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1016.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天站稳5010点，行情就理所当然地继续展开。现在其实只要看好日线就可以，因为日线上必然形成笔，而该笔必然结束于顶分型，换言之，在日顶分型出现前，都不会有行情的结束，就算你是最急噪的人，也先等日分型出现再说了。"}, "正文字数": {"number": 299}, "年份": {"number": 2007}}, {"标题": {"text": "为什么发不出帖子？"}, "发布时间": {"date": "2007-12-07"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1017.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": ""}, "正文字数": {"number": 16}, "年份": {"number": 2007}}, {"标题": {"text": "没雪的日子，赋七律：雪域"}, "发布时间": {"date": "2007-12-08"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1018.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "抱歉上来一看，昨天重复发也发不出的帖子竟然都出来了，各位也将就一下，新浪也就是一年出N次问题，没什么不可原谅的。"}, "正文字数": {"number": 256}, "年份": {"number": 2007}}, {"标题": {"text": "教你打坐18：你，来自一对发情男女？"}, "发布时间": {"date": "2007-12-09"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1019.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "后面的内容，越来越难。之所以难，并不是说道理上有什么难的，而是纯粹的道理上、语言上的谈论，甚至连黄叶止啼都算不上。"}, "正文字数": {"number": 1989}, "年份": {"number": 2007}}, {"标题": {"text": "今天不是530"}, "发布时间": {"date": "2007-12-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1020.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天不是530，为什么？你见过530北京下雪吗？既然北京都下第一场雪了，大盘当然也要放放血，见见红了。"}, "正文字数": {"number": 680}, "年份": {"number": 2007}}, {"标题": {"text": "请中国的经济管理层先学会中医吧"}, "发布时间": {"date": "2007-12-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1021.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID股票理论中，第一类买卖点，就是治其未病；第二类买卖点，就是治其欲病；第三类买卖点，就是治其已病，这也是和中医相通的。"}, "正文字数": {"number": 1187}, "年份": {"number": 2007}}, {"标题": {"text": "反弹剧本第一目标胜利完成"}, "发布时间": {"date": "2007-12-11"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1022.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天完成补缺任务后展开震荡，一个完美的1分钟中枢也就此构成，尾盘在1分钟中枢的第三分线段结束后重新拉回5151点之上，就确认了这个震荡中枢的有效性。后面，5151点是一个关键位置，只要能围绕着震荡，就不会有大问题。"}, "正文字数": {"number": 1138}, "年份": {"number": 2007}}, {"标题": {"text": "今天只说点闲话"}, "发布时间": {"date": "2007-12-11"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1023.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "当利物浦球迷，对心理素质的要求，除了中国球迷外，大概是全球最高的了。现在的利物浦已经越来越不利物浦，什么时候连杰拉德之类的人都不在了，本ID大概也要换换新空气。"}, "正文字数": {"number": 546}, "年份": {"number": 2007}}, {"标题": {"text": "第一目标达到后的例行休整"}, "发布时间": {"date": "2007-12-12"}, "主题": {"multi_select": ["均线系统"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1024.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天给了一个判别休整强弱的重要点位，就是5151点，显然，今天开盘就跌破且反抽不上，就明白无误地告诉各位休整的弱势性质。5151点依然是后续关键的位置，在站稳该位置之前，大盘不可能重新走强。"}, "正文字数": {"number": 1202}, "年份": {"number": 2007}}, {"标题": {"text": "也来歌功颂德一番"}, "发布时间": {"date": "2007-12-12"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1025.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天早上的利物浦最利物浦地利物浦了一把，没什么可太兴奋的。倒是这两天，歌功颂德的声音图象铺天盖地，搞得嫦娥她姥姥失色、吴刚他爷爷失身、连玉兔它婶婶也失态地满宇宙乱窜。本ID本没有如此歌功颂德的爱好，不过觉得不凑凑热闹，也太对不住嫦娥她姥姥、吴刚他爷爷、玉兔它婶婶了，看来不整点来风雅颂一番确实要落伍啊。"}, "正文字数": {"number": 413}, "年份": {"number": 2007}}, {"标题": {"text": "今天说股票是无耻的"}, "发布时间": {"date": "2007-12-13"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1026.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "南京大屠杀七十年祭 缠中说禅 一 金陵王气压扬州大国生民不缺头三十万人同日死断无一个属公侯 二 钟山风雨几苍黄江水依然日月长七十年翻雄国梦赚来东海小鹰狂"}, "正文字数": {"number": 192}, "年份": {"number": 2007}}, {"标题": {"text": "顶分型确立显威力"}, "发布时间": {"date": "2007-12-14"}, "主题": {"multi_select": ["中枢结构", "牛熊判断", "均线系统"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1027.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天早上反抽不上5日线，顶分型确立。当然，顶分型确立，并不一定要拉出长阴线，但更不一定不拉出长阴线，10条短阴线与一条长阴线，只要不出现底分型，最终都只是指向一个向下笔的过程。而站在本ID理论的角度，只关心买卖点的结果，并不关心过程。"}, "正文字数": {"number": 1502}, "年份": {"number": 2007}}, {"标题": {"text": "周底分型构成待确立"}, "发布时间": {"date": "2007-12-14"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1028.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "上周给了本周一个任务，就是去构成周底分型，今天早上也特别强调这一点，现在任务算是完成了。下周的任务也先给出，就是去确认周底分型的确立，技术上十分简单，就是5周均线站住。"}, "正文字数": {"number": 1406}, "年份": {"number": 2007}}, {"标题": {"text": "再赋《临江仙》"}, "发布时间": {"date": "2007-12-15"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1029.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "又是大清早才睡的，刚起来，心里不爽。昨天晚上又喝酒了，喝的是老窖，结果早上一看，见到“泸州老窖北京公司要求全员辞职”的新闻，更不爽，看来这老窖已经也没法喝了。"}, "正文字数": {"number": 764}, "年份": {"number": 2007}}]