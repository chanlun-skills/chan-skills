[{"标题": {"text": "教你打坐19：认识你自己"}, "发布时间": {"date": "2007-12-16"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1030.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这题目是一个古老的希腊格言，当然，这句话也是一个巨大的陷阱，这句话成立之前提，至少有三个：一、存在你自己这种可认识的玩意。二、你自己的认识具有这样一种神秘的力量，可以认识你自己本身。三、认识你自己与不认识你自己有着本质的不同，也就是认识你自己就有了一种超越不认识你自己的力量。"}, "正文字数": {"number": 2412}, "年份": {"number": 2007}}, {"标题": {"text": "抛弃指数，冰火两重天。"}, "发布时间": {"date": "2007-12-17"}, "主题": {"multi_select": ["牛熊判断", "中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1031.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天，并没有构成日的底分型，只是制造了一个典型的包含关系。由于离周五低位很近，所以只要明天比周五低，那么就意味着5209点开始的下跌笔依然要延续。"}, "正文字数": {"number": 786}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票91：走势结构的两重表里关系1"}, "发布时间": {"date": "2007-12-17"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1032.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "判断走势，如同中医看病，未病而治的是第一等的，次之的是对治欲病，到已病阶段，那只能算是亡羊补牢了。但绝大多数的人，病入膏肓了还在幻想，市场里最终牺牲的，总是这种人。"}, "正文字数": {"number": 3333}, "年份": {"number": 2007}}, {"标题": {"text": "多头，早死早投胎还是背水一战。"}, "发布时间": {"date": "2007-12-18"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1033.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "中线上，本ID已经反复强调，反抽以后必然还要探底，而在11月底谈论12月月K线形态时，就明确说过，至少有上影对11月长影实体进行反抽，这点已经做到了。后面的问题其实很简单，就是这月K线是包含关系，还是继续月上的向下笔延伸，也就是4778点是否要在12月被破。一旦被破，也就是月线上要走出向下笔，在月出现新的底分型之前，一切中级的向上都免谈，这在技术上是不需要分析的，是必然的。"}, "正文字数": {"number": 1290}, "年份": {"number": 2007}}, {"标题": {"text": "《论语》详解：给所有曲解孔子的人（71）"}, "发布时间": {"date": "2007-12-18"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1034.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "杨伯峻：孔子说：“君子对于天下的事情，没规定要怎样干，也没规定不要怎样干，只要怎样干合理恰当，便怎样干。”"}, "正文字数": {"number": 1906}, "年份": {"number": 2007}}, {"标题": {"text": "多头绝地反击，仍需努力。"}, "发布时间": {"date": "2007-12-19"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1035.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "青蛙要成神仙，多头要真正逃出绝地，最基本的位置昨天也说了，就是5032点，这样，基本还是继续保持5000点附近的大级别震荡。当然，光震荡还是没用的，5209点的颈线还是必须攻克，否则最终青蛙还是要变成清炖青蛙。"}, "正文字数": {"number": 606}, "年份": {"number": 2007}}, {"标题": {"text": "真是无奈，越来越身不由己（七律一首）"}, "发布时间": {"date": "2007-12-19"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1036.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "9点要去喝茶，很无聊的事情，赶快说上两句。明天还要出一次差，不过是晚上的事，明晚的帖子是不能写了。不过，在4点多会给出一个关于明年大盘的基本分析。"}, "正文字数": {"number": 572}, "年份": {"number": 2007}}, {"标题": {"text": "攻克5032，完成初步任务。"}, "发布时间": {"date": "2007-12-20"}, "主题": {"multi_select": ["中枢结构", "大盘解盘"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1037.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "因为晚上要出差，所以等一下就把晚上关于明年大盘走势的展望写了，4点左右贴出来。明天收盘尽量解盘，如果没时间，就在周六或周日补上。"}, "正文字数": {"number": 1020}, "年份": {"number": 2007}}, {"标题": {"text": "2008年行情展望"}, "发布时间": {"date": "2007-12-20"}, "主题": {"multi_select": ["牛熊判断", "政策与基本面", "均线系统"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1038.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "年末，不可免俗地要对明年的行情展望一番。今年，无论是5月份的180个月时间周期、6100点的顶部以及调整的第一落脚点120天线，都被预先剧本了。不过，现在完全精确剧本明年走势，几乎是不可能的，因为明年市场上的可变分力太多，下面只从纯技术的角度进行一些界定性的分析。"}, "正文字数": {"number": 2293}, "年份": {"number": 2007}}, {"标题": {"text": "加息再为市场打鸡血"}, "发布时间": {"date": "2007-12-21"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1039.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "技术上，今天没什么可说的，顶分型在日线上不出现，1分钟的上涨不出现背驰，就可以继续睡觉等卖点。"}, "正文字数": {"number": 394}, "年份": {"number": 2007}}, {"标题": {"text": "外面正下着雨，酒店里闲话"}, "发布时间": {"date": "2007-12-22"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1040.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "刚回酒店，南方的冬夜，下着寒雨，和北京真是大不同。外面是这个城市最大的广场，子夜时分，依然灯火璀璨，车流涌动。城市总是令人生厌，特别在这样一个遥远的夜晚，世界如此遥远，城市多余地忙碌着。"}, "正文字数": {"number": 356}, "年份": {"number": 2007}}, {"标题": {"text": "老老实实做人"}, "发布时间": {"date": "2007-12-22"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1041.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "人，首先要吃喝拉撒，这就是人。但人总爱那些非人之举，而所有非人之举后面，不过都是虚伪欺骗。"}, "正文字数": {"number": 290}, "年份": {"number": 2007}}, {"标题": {"text": "饭后无聊，将前夜所写草成五律一首"}, "发布时间": {"date": "2007-12-23"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1042.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "人，首先要老老实实做人。但，人如果只能是人，那这人也只能是废人。人就是你的当下，不离当下，不即当下，连这都不明白，算是白活了。"}, "正文字数": {"number": 209}, "年份": {"number": 2007}}, {"标题": {"text": "鸭头铡再铡周树人"}, "发布时间": {"date": "2007-12-23"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1043.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "周树人，一只叫鲁迅的玩意，最近又被那些兔子兔孙所口淫。为什么是鸭头铡？因为这玩意上不了狗头铡，也上不了猪头铡，也就配上这鸭头铡。"}, "正文字数": {"number": 917}, "年份": {"number": 2007}}, {"标题": {"text": "做账行情，突破颈线待确认"}, "发布时间": {"date": "2007-12-24"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1044.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "自从有了开放式基金，年末这轮做账行情就变得常规性了。多头因此也华山一条路就走出前面给出的唯一活命选择，直接突破5209点的颈线。现在，唯一需要等待的，就是突破有效的确认，确认以后，下一目标就是这双底的基本涨幅，大概就在5600点上下。确认不了，那就回去再震荡震荡等机会。"}, "正文字数": {"number": 705}, "年份": {"number": 2007}}, {"标题": {"text": "那一夜，他的体液喷了我一身（二十八）"}, "发布时间": {"date": "2007-12-24"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1045.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "【XX】对XXX说：高/重/年龄 XXX对【XX】说：180/80/43 【XX】对XXX说：从事什么？ XXX对【XX】说：中文系副教授，主攻现代小说与武侠小说，鲁迅研究专家。 【XX】对XXX说：哈哈，你很环保。"}, "正文字数": {"number": 1508}, "年份": {"number": 2007}}, {"标题": {"text": "5209点，教科书式震荡"}, "发布时间": {"date": "2007-12-25"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1046.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天没什么可说的，该说的昨天都说了。今天就是教科书式地在5209点上下折腾出一个1分钟中枢，就这么简单。而这中枢的中间位置在5210点，比5209点差了一点，这是唯一不完美的地方。"}, "正文字数": {"number": 780}, "年份": {"number": 2007}}, {"标题": {"text": "何谓五四小儿的西方老爸葱白的人性"}, "发布时间": {"date": "2007-12-25"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1047.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "五四小儿开始，就有一群脑子进水的垃圾人，喜欢谈论它们西方老爸的所谓人性。何谓人性？对于五四小儿的西方老爸来说，人性就是超越诸如种族、国家等等的一种上帝玩意。它们的西方老爸告诉它们，超越了中国、超越了中华民族、超越了你的身体、你的一切，还有一种叫人性的玩意，你们快葱白它吧，它是上帝。"}, "正文字数": {"number": 1138}, "年份": {"number": 2007}}, {"标题": {"text": "面临短线突破选择"}, "发布时间": {"date": "2007-12-26"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1048.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天一开盘就受到一个电话严重的嘲笑，什么内容，等一下再说。不过，收盘了，本ID也要先来一个超级简单的问题刁难一下各位，请问：今天的高低点和昨天说的中枢中间位置5210点有什么关系？"}, "正文字数": {"number": 779}, "年份": {"number": 2007}}, {"标题": {"text": "胡汉三又回来了？"}, "发布时间": {"date": "2007-12-26"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1049.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID不想制造地域争论，但河南，姜子牙、老子、庄子、吴起、杜甫、韩愈、岳飞的故乡，特别还是戚继光的故乡，竟然在小日本来的时候，不少当地农民自发地起来帮助日本人，这样的历史事实意味着什么？"}, "正文字数": {"number": 553}, "年份": {"number": 2007}}, {"标题": {"text": "教科书式突破如期而至"}, "发布时间": {"date": "2007-12-27"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1050.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说了，由于30分钟的布林通道收口，所以短线面临突破选择。今天的突破，在时间上是十分教科书的，一般这种中枢突破，用布林通道来预估是比较有效，这点在课程里已经说过。"}, "正文字数": {"number": 1203}, "年份": {"number": 2007}}, {"标题": {"text": "教你炒股票92：中枢震荡的监视器"}, "发布时间": {"date": "2007-12-27"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1051.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "中枢震荡，最终一定以某级别的第三类买卖点结束。但问题是，如何预先给出有参考价值的提示，也就是如何去监控这震荡是在逐步走强，还是逐步走弱，这是一个有操作价值的问题。当然，顺便地，可以为每次的震荡高低点的把握给出一个大致的区间。"}, "正文字数": {"number": 1351}, "年份": {"number": 2007}}, {"标题": {"text": "2007年低调收盘预示明年行情性格"}, "发布时间": {"date": "2007-12-28"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1052.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "其实，这句话是有问题，今天指数虽然低调，但个股并不是都低调，例如本ID说那些股票，大多数就都继续在上攻。这也预示了明年的一个基本特征，指数油水不太大（除非期货很快出来），而个股油水不少。关于明年的分析，一早已经给出，请看“2008年行情展望 2007-12-20 15:59:05”"}, "正文字数": {"number": 954}, "年份": {"number": 2007}}, {"标题": {"text": "赋《沁园春》兼祝各位2008新年好"}, "发布时间": {"date": "2007-12-28"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1053.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "《沁园春》 缠中说禅 踏浪天河，扬九星帆，执七斗壶。命吴刚酿就，月宫桂酒；羲和摘献，日殿龙珠。黑洞探玄，灰熊试剑，今古乾坤入有无。谁堪共？尽时空隧道，声色荆途。 森罗万象如如，能纵目，头头皆是吾。笑王臣兵贼，千朝百国；人神鬼兽，六合三涂。幻海风迷，浮沤梦戏，意画心描自主奴。何所缚？转黄金大地，毒药醍醐。"}, "正文字数": {"number": 237}, "年份": {"number": 2007}}, {"标题": {"text": "08年证券市场的头等大事：尚主席，该高升了。"}, "发布时间": {"date": "2008-01-01"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1054.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID是严重反对“中国大妓院”这样的名字的，因为这里存在着严重的男权思维，但这样的称呼，至少在北京私底下已早不新鲜。这么多血汗钱，如果能搞出个真玩意，那还算是个玩意；但连个玩意都没搞太好，那究竟是什么玩意那就不用再玩意了。"}, "正文字数": {"number": 1122}, "年份": {"number": 2008}}, {"标题": {"text": "指数疲软下的个股高潮不断"}, "发布时间": {"date": "2008-01-02"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1055.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "如同这题目，第一天的行情继续预示着本年行情的特点，指数油水不大，个股油水不少，这已经在去年末反复说到了。用句概括性、动感更大的口号，就是：疲软指数，高潮个股。"}, "正文字数": {"number": 784}, "年份": {"number": 2008}}, {"标题": {"text": "毛泽东与周树人"}, "发布时间": {"date": "2008-01-02"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1056.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID比较专一，就算419，也要把玩物给玩废了才收手。最近既然已经把周树人这垃圾股反复拉抬打压进行抽血性操作，那么最后，肯定要往退市的路上把这鸭子给挤兑了。"}, "正文字数": {"number": 601}, "年份": {"number": 2008}}, {"标题": {"text": "向5600高地攻击前进"}, "发布时间": {"date": "2008-01-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1057.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "站住5209点颈线，下一位置就是5500-5600一线，这是十分简单的技术问题了。由于这个5分钟的中枢震荡还没有震荡出第三类买点，所以说这颈线突破100%有效是不严谨的。但生活有时候并不太严谨，否则就太无趣了，所以，没有100%的把握已经确认的事情，我们依然可以喊：向5600高地攻击前进。"}, "正文字数": {"number": 838}, "年份": {"number": 2008}}, {"标题": {"text": "自古以来超第一英明神武的政治高手"}, "发布时间": {"date": "2008-01-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1058.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "右派认为，毛大爷是暴君，样样不行，还是它们的华盛顿厉害，蒋光头也不错。本ID就奇怪了，只有奴才才到处认什么君，把毛大爷当成暴君，那潜台词就是右派把自己当成被暴君了的臣子、奴才，看来，右派见了毛大爷就发抖，连斗地主都输给毛大爷，确实有着很弗洛伊德的原因，所以，我们就原谅它们吧。"}, "正文字数": {"number": 1061}, "年份": {"number": 2008}}, {"标题": {"text": "多头，有了冲动就要喊。"}, "发布时间": {"date": "2008-01-04"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1059.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天走势最大的意义是什么？站在本ID理论的角度，就是突破5336使得周线上（1，1）的状态延续，在周线的（1，0）出来之前，也就是周线顶分型出现之前，尽管持股睡大觉。"}, "正文字数": {"number": 1021}, "年份": {"number": 2008}}, {"标题": {"text": "阅读律诗的一些基本知识"}, "发布时间": {"date": "2008-01-04"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1074.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "由于五四小子与六六痴儿的折腾，本来最基本的中华文化常识，在中国人里都全面缺乏了。像本ID这类后文革时代出生的人，如果还像我们这些父辈一样，中华文明就真是万劫不复了。"}, "正文字数": {"number": 2035}, "年份": {"number": 2008}}, {"标题": {"text": "诗人画廊（一）：李煜/李商隐"}, "发布时间": {"date": "2008-01-05"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1060.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "对于被白话文毒害的人来说，律诗有所谓的枷锁。其实，律诗哪里有枷锁？本ID只看到自由。从今天开始，本ID就要用七律给世界上自古以来本ID看得上眼的诗人画像，组成一诗人的画廊。这画廊要慢慢来，先请出李煜/李商隐。"}, "正文字数": {"number": 392}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐20：你是什么"}, "发布时间": {"date": "2008-01-06"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1061.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "你，一无所有。那么，你是什么？是那一无所有的某种玩意吗？如果你就是一无所有的某种玩意，那还是你的什么，而不是你。"}, "正文字数": {"number": 1332}, "年份": {"number": 2008}}, {"标题": {"text": "勇戴金箍大翻筋斗云"}, "发布时间": {"date": "2008-01-07"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/somersaultcloud"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "大概现在没有人会反对本ID一直强调的两点：一、疲软指数，高潮个股，指数让他抽两抽抖10抖；二、先下手才会早点有面包，晚了，等紧箍咒变成大铁笼，我们就啃着面包看笼里的八戒变飞天大乳猪吧。"}, "正文字数": {"number": 658}, "年份": {"number": 2008}}, {"标题": {"text": "勇戴金箍大翻筋斗云"}, "发布时间": {"date": "2008-01-08"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1062.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "大概现在没有人会反对本ID一直强调的两点：一、疲软指数，高潮个股，指数让他抽两抽抖10抖；二、先下手才会早点有面包，晚了，等紧箍咒变成大铁笼，我们就啃着面包看笼里的八戒变飞天大乳猪吧。"}, "正文字数": {"number": 661}, "年份": {"number": 2008}}, {"标题": {"text": "5462点如期较大震荡"}, "发布时间": {"date": "2008-01-08"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/5462shocking"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "昨天已说“本周出现一次有点力度的震荡是很正常的，毕竟6124点下来的所谓双顶颈线5462点已经在面前”，今天早上的跳空以及下午的线段类顶背驰，理所当然地形成对5462点第一次冲击后的必然震荡。"}, "正文字数": {"number": 1312}, "年份": {"number": 2008}}, {"标题": {"text": "毛大爷与蒋光头"}, "发布时间": {"date": "2008-01-08"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1063.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "其实，蒋光头根本没资格和毛大爷相比较。政治是什么？成王败寇。蒋光头在毛大爷面前输得连内裤都没有，只好打劫国宝、偷运黄金，靠着美国主子的庇护苟活，你说他有什么资格和毛大爷比？"}, "正文字数": {"number": 795}, "年份": {"number": 2008}}, {"标题": {"text": "上涨动力，来自清洗。"}, "发布时间": {"date": "2008-01-09"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzh