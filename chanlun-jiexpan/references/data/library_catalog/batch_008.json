l": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1067.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "很对不起，要令毛大爷的粉丝极端失望，他们眼里的第一军事天才、统帅，在这位牛人面前，就算不了什么了。"}, "正文字数": {"number": 1438}, "年份": {"number": 2008}}, {"标题": {"text": "2008年，谨防宏观调控过度"}, "发布时间": {"date": "2008-01-10"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1069.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "按照中医的观点，治人与治国的道理是相通的。而对经济的调控，显然是治国中一个极为重要的方面。经济之病，与人体之病的道理，也是相通的。"}, "正文字数": {"number": 1376}, "年份": {"number": 2008}}, {"标题": {"text": "因为饿，所以疯狂。"}, "发布时间": {"date": "2008-01-11"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/hungrycrazy"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天的大盘，没什么可说。周末效应了一把，但依然继续对5462点的震荡确认，今天当然只会是试探性质的，完全没必要在指数上干些只争朝夕的事情。"}, "正文字数": {"number": 588}, "年份": {"number": 2008}}, {"标题": {"text": "把下面的指数剧本告诉你"}, "发布时间": {"date": "2008-01-11"}, "主题": {"multi_select": ["板块与个股"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1068.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "所以，所有关于上涨的有野心的剧本，第一原则，就是先把深圳成分股给挑出一片蓝天，如果深成指都没有蓝天，其他指数就更要一边晾着了。"}, "正文字数": {"number": 925}, "年份": {"number": 2008}}, {"标题": {"text": "诗人画廊（2）：裴多菲/拜伦"}, "发布时间": {"date": "2008-01-12"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1071.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID的画廊，可没说是狭隘民族主义的玩意，古今中外，只要有这资格的，都会被请到。今天，就请来俩金发碧眼的，用中国最格律化的七律与之画像，而且，以后还要继续歌德莎士比亚地串成一大糖葫芦。"}, "正文字数": {"number": 321}, "年份": {"number": 2008}}, {"标题": {"text": "因为饿，所以疯狂。"}, "发布时间": {"date": "2008-01-12"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1070.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的大盘，没什么可说。周末效应了一把，但依然继续对5462点的震荡确认，今天当然只会是试探性质的，完全没必要在指数上干些只争朝夕的事情。"}, "正文字数": {"number": 597}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐21：你的是什么"}, "发布时间": {"date": "2008-01-13"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1072.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "你，一虚妄添加的幻象，那么，“你的”是什么。所有面对的，都是“你的”，不是“你”，“你的”又是什么？"}, "正文字数": {"number": 977}, "年份": {"number": 2008}}, {"标题": {"text": "指数犹疑，个股补涨"}, "发布时间": {"date": "2008-01-14"}, "主题": {"multi_select": ["板块与个股", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1073.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "到了目前这个位置和时间段，大盘进入敏感阶段。首先，对于多头来说，好不容易到了5600点上下这最重要的阻力跟前，绝对不想一个哆嗦就给震回去。但这个关口确实比较压力大，主要不是技术上的，而是心理与政策面上的。"}, "正文字数": {"number": 624}, "年份": {"number": 2008}}, {"标题": {"text": "大盘压力期下的多头策略"}, "发布时间": {"date": "2008-01-15"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1075.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "已经反复说过，目前大盘进入压力期，首先是政策的敏感期，其次，技术上也有相应的重压力区在面前，更重要的是，除了大家伙，板块在基本轮动一次后，很多股票都进入相对的调整期，这时候对多头来说，确实有点压力。"}, "正文字数": {"number": 591}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票93：走势结构的两重表里关系2"}, "发布时间": {"date": "2008-01-15"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1076.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "剩下的筹码可以这样操作，就是如果出现（-1，1），那么意味着低周期图上肯定也出现（-1，1），那么在这个向下笔结束后回来的向上笔只要不创新高，就可以把剩余筹码扔掉。例如周的，你可以看日或者30分钟周期的低周期。当然，还可以直接就看周的5周均线，只要有效跌破就走，这可能更简单。"}, "正文字数": {"number": 1188}, "年份": {"number": 2008}}, {"标题": {"text": "大盘又见亮晶晶"}, "发布时间": {"date": "2008-01-16"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1077.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说“并不排除有一到两天让大家再次想起亮晶晶的机会”，结果，今天那花旗参大作广告，使得大盘又见亮晶晶，严重怀疑亮晶晶暗中代理了花旗参的销售。"}, "正文字数": {"number": 940}, "年份": {"number": 2008}}, {"标题": {"text": "填词又见《临江仙》"}, "发布时间": {"date": "2008-01-16"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1078.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "晚上就走，先到汉口，然后才去深圳。看看今年和湖北有没有缘分，能不能搞点事情。临走前，再来一首《临江仙》，估计周日或周一才能晚上写帖子了，抱歉。"}, "正文字数": {"number": 167}, "年份": {"number": 2008}}, {"标题": {"text": "不会享受大震荡的人股票就没入门"}, "发布时间": {"date": "2008-01-17"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1079.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "当然，享受有不同级别，一种是被动型的，一种是主动型。被动的就不说了，都是电梯广告的最好代言。而主动型的，就要靠技术了。"}, "正文字数": {"number": 1084}, "年份": {"number": 2008}}, {"标题": {"text": "今年投资者的四种命运"}, "发布时间": {"date": "2008-01-18"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1080.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "早上走势，和昨天说的一致，就是两天的亮晶晶后，震荡还有，但幅度变小，但由于5209点没重新站住，大盘总体还在一个剧烈震荡后的平复期，依然有较大不稳定因数与情绪需要时间平复，另外，周末的政策消息面以及外围因素，依然有巨大的心理影响。"}, "正文字数": {"number": 2144}, "年份": {"number": 2008}}, {"标题": {"text": "多头能否构建缓升通道？"}, "发布时间": {"date": "2008-01-19"}, "主题": {"multi_select": ["大盘解盘"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1081.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "周五大盘这种走势，已经在周四解盘中说过了，就是震荡幅度减少，等待消息、心理面的平复。周五，一个标准的箱型震荡，最后高收，由于5209点的跌破，没有到三天的基本限期，所以只要下周初能站上去，就可以了。"}, "正文字数": {"number": 1201}, "年份": {"number": 2008}}, {"标题": {"text": "刚到家，说两句"}, "发布时间": {"date": "2008-01-20"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1082.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "每个人，每一个念头、行为、语言，都在造业，都在种下种子，而更为重要的，每一种子，马上就结出果实，而这果实相续而去，等到机缘成熟显发出来。如此一说，大概真正相信者不多，因为没有实证，不会有人真正相信。"}, "正文字数": {"number": 398}, "年份": {"number": 2008}}, {"标题": {"text": "又被暗算的多头尚能饭否？"}, "发布时间": {"date": "2008-01-21"}, "主题": {"multi_select": ["中枢结构", "牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1083.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "刚被花旗参暗算完，周末又被平安保险暗算了一把，多头至少在指数上已经没有任何的回旋余地。技术上，前面已经说了，5209点不能重新站住，就要二次探底，直到出现日的底分型为止。而一个30分钟震荡，4778点在最坏的情况下完全可以被击破。被暗算的多头今天开盘无力站上5209点，就使得后面的走势变得只能以坏的选择去选择了。"}, "正文字数": {"number": 1661}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票94：当机立断"}, "发布时间": {"date": "2008-01-21"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1084.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "例如，在现在，对以后的大盘走势，我们马上可以分析出所有必然出现的机会：1、一个最小的机会，就是大盘线段下移后形成的线段类背驰，这里对应这两个目标，最好的是回拉上面的1分钟中枢从而形成5分钟中枢，剩下的就是形成第二个1分钟的下跌中枢。"}, "正文字数": {"number": 2194}, "年份": {"number": 2008}}, {"标题": {"text": "超短线反弹在即"}, "发布时间": {"date": "2008-01-22"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1085.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "看今天的帖子之前，如果没有看过下面的帖子的，请先看看“2008年行情展望 2007-12-20 15:59:05”"}, "正文字数": {"number": 714}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票95：修炼自己"}, "发布时间": {"date": "2008-01-22"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1086.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "本ID觉得，当人被刺激后，大概学习的效率会高点，所以就连续写课程了，让有缘人得之。"}, "正文字数": {"number": 1490}, "年份": {"number": 2008}}, {"标题": {"text": "如期反弹后的4778点压力"}, "发布时间": {"date": "2008-01-23"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1087.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天没什么可说的，该说的昨天就说了，关于这个反弹点，前两天的课程里已经预先说过，这就是本ID理论输出与实际走势的绝对一一对应性所决定的。"}, "正文字数": {"number": 1467}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票96：无处不在的赌徒心理"}, "发布时间": {"date": "2008-01-23"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1088.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "市场中，最大的敌人之一，就赌徒心理、赌徒思维。赌，最终的结局就只有一个，如果你以赌徒心理参与市场，那么你的结局就已经注定，你就算还没再锅里，那也只是养肥了再煮而已，没什么区别。"}, "正文字数": {"number": 1626}, "年份": {"number": 2008}}, {"标题": {"text": "4778点，多空抉择线。"}, "发布时间": {"date": "2008-01-24"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1089.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "从日线上，今天早上的下跌反而是为了最终构成日的底分型，这是一个买点。但后面的问题更为关键，就是这底分型能否延伸为笔，还是最终被5日线压制夭折。由于5日线已经下移到4815点，明天大概也就到4778点附近了，因此，这个问题和上面一个问题是同解的，还是4778点能否突破站住的问题。"}, "正文字数": {"number": 882}, "年份": {"number": 2008}}, {"标题": {"text": "你会起床吗？"}, "发布时间": {"date": "2008-01-24"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1090.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "各位最近受刺激比较多，因此要多多关心身体。本ID就说说有关身体的问题，你会起床吗？"}, "正文字数": {"number": 1373}, "年份": {"number": 2008}}, {"标题": {"text": "下周补缺，多头别无选择"}, "发布时间": {"date": "2008-01-25"}, "主题": {"multi_select": ["牛熊判断"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1091.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "4778点，其实就是一张纸，但现在人的心理，比纸都脆弱，看来风险教育还是太少，股灾见得还不够多。看看人家恒生指数，上窜下跳地，A股的投资者还是少历练。"}, "正文字数": {"number": 1067}, "年份": {"number": 2008}}, {"标题": {"text": "步老杜《登高》韵记梦"}, "发布时间": {"date": "2008-01-26"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1092.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "海啸山癫参斗哀雷烹电沸夜惊回熯天血雨追风下坼地悲歌踏梦来岁月无情空掷泪乾坤多病怒登台茫茫大野归何处万古云霄一酒杯"}, "正文字数": {"number": 127}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐22：佛魔最难除"}, "发布时间": {"date": "2008-01-27"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1093.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "所有这些玩意，无一不是在意识之中打转转，生死到来，顶个屁用。鉴别这些人的第一步，你就看，这些教导的玩意，生死到来，有用否？就算你练得一丝所谓的妄念都没有，心无分别到看大盘从10000点到0点与0点到10000点是一回事情，别人打了你两边脸你还要把屁股送上受虐，可以1000天不吃饭不喝水照样可以N的平方P，诸如此类，生死到来，有用吗？"}, "正文字数": {"number": 1384}, "年份": {"number": 2008}}, {"标题": {"text": "580989完美地达到理论要求的第一目标。"}, "发布时间": {"date": "2008-01-28"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1094.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "强烈注意，580989几个月后连纸都不如，特别在上涨这么多以后，任何人都不能再参加了，除非你是在底分型时买入的而且有极高的震荡技术。这东西最后的命运是0，千万注意。"}, "正文字数": {"number": 1247}, "年份": {"number": 2008}}, {"标题": {"text": "中国，需要的是中国式的全球化"}, "发布时间": {"date": "2008-01-28"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1095.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "最近，美国次级债，使得那些一度被国内金融投资界当成偶像膜拜的美国大金融机构大丢其脸、大伤其气。金融投资领域，从来就没有偶像，风险对任何人都是公平的，曾经让你辉煌的可能就是让你最后葬身的陷阱，这一点，大概不会有任何中美的差别。"}, "正文字数": {"number": 1732}, "年份": {"number": 2008}}, {"标题": {"text": "吃完饭上来说两句"}, "发布时间": {"date": "2008-01-28"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1096.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "很简单，你要考察自己的水平，请回答下面的问题：请列出最近三个必然发生不会遗漏的机会，并说明其必然的级别。"}, "正文字数": {"number": 1662}, "年份": {"number": 2008}}, {"标题": {"text": "年线支持初显现"}, "发布时间": {"date": "2008-01-29"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1097.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "首先还是说580989，你看那中枢的力量是多么巨大，早上的远离，后面的回拉，一切如教科书一般，围绕这个原来的中枢进行震荡，这在昨天已经说了，后面震荡逐步减少，由于该中枢大致在0.6一线，依次向下的震荡空间是存在的。想想一个中枢震荡可以从0.4到0.95，这就是震荡的力量。"}, "正文字数": {"number": 946}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票97：中医、兵法、诗歌、操作1"}, "发布时间": {"date": "2008-01-29"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1098.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "再说一次，一定要看走势图，那是世界上最昂贵的图画，最昂贵的艺术品，多看，就如同培养你的鉴赏力，为什么玩古董的，很多人总是被假玩意骗，而有人就能专破假玩意，这就是鉴赏力等的问题，但这是需要磨练的。磨练的时候，被骗几次，那不是最正常不过的事情？"}, "正文字数": {"number": 2225}, "年份": {"number": 2008}}, {"标题": {"text": "看别人脸色的日子总是不好过的"}, "发布时间": {"date": "2008-01-30"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1099.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "说实话，现在本ID已经没有上次接石头的兴趣，对今年的行情，本ID去年已经给了明确的定位，就是题材股大搞，不管指数，所以才有了跌了1000多点还创新高的品种。"}, "正文字数": {"number": 915}, "年份": {"number": 2008}}, {"标题": {"text": "合格政府的第一标准：不给美国佬埋单"}, "发布时间": {"date": "2008-01-30"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1100.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "这不是针对任何具体的政府的，而是一般性的表述。这句话，显然是武断的，但在这样一个时刻，必须有这样的武断。"}, "正文字数": {"number": 884}, "年份": {"number": 2008}}, {"标题": {"text": "没有信心，一切瞎掰。"}, "发布时间": {"date": "2008-01-31"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1101.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "3点半有一无聊人从大连专程过来要谈一香港市场收壳的事情，谈完以后回来会写一篇纯技术分析后面走势的帖子。本ID现在的心情已经完全过年化了，想起还要有事情干就头疼。"}, "正文字数": {"number": 795}, "年份": {"number": 2008}}, {"标题": {"text": "大盘中线技术分析"}, "发布时间": {"date": "2008-01-31"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1102.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "收盘的帖子，非技术的纯粹直话直说的，这是走势后面必须的东西。但操作上，还是必须按技术来，所以技术是第一的，我们可以用一些语言对分力进行敲打，但这不能蒙蔽了技术的眼睛。特别，对于一般的散户来说，除了图形，你是最公平地和所有人同时看到的，你还能有什么依靠？"}, "正文字数": {"number": 1709}, "年份": {"number": 2008}}, {"标题": {"text": "节前连涨三天？就不许！"}, "发布时间": {"date": "2008-02-01"}, "主题": {"multi_select": ["牛熊判断", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1103.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "如果脑子里还有一丝幻想的，请再把本ID关于今年走势展望的帖子再读一次：“2008年行情展望 2007-12-20 15:59:05”"}, "正文字数": {"number": 2238}, "年份": {"number": 2008}}, {"标题": {"text": "没有幽默感与修养成不了好的操作者"}, "发布时间": {"date": "2008-02-01"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1104.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "快过年了，到处繁忙，还是待在家里塌实。一般周五晚上都不写帖子，这次就破例一次。因为在周六、日不谈股票，就抓紧今晚再说说股票。"}, "正文字数": {"number": 731}, "年份": {"number": 2008}}, {"标题": {"text": "不同层次的人"}, "发布时间": {"date": "2008-02-02"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1105.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "人，是分不同层次的，而且，是金字塔分布的，这点，绝对不需要讳言。以任何指标为选项，这种层次都是存在的。当然，一般人更注重财富、美貌、才华之类外在的东西，这里，是从人的思维惯性进行一些考察。"}, "正文字数": {"number": 1338}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐23：“任”病最缠人"}, "发布时间": {"date": "2008-02-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1106.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "其实，“任”病归根结底来自“你”自我设计的幻象，所有的“任”病模式，都出不了意识的范围，说得粗暴点，就是自渎。"}, "正文字数": {"number": 942}, "年份": {"number": 2008}}, {"标题": {"text": "七绝：给大雪中国里的蛇虫鼠蚁"}, "发布时间": {"date": "2008-02-03"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1107.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "看到不少蛇虫鼠蚁趁着大雪冒出来，以为一个打击中国、打击中国政府的时刻又到了，这些早被扫到垃圾堆里的玩意，迫不及待地又开始表现。中国的命运，能交给这些只会舔他们美国爸爸、日本二爸爸的垃圾吗？按照这些人的逻辑，上次美国的飓风、东南亚海啸，他们怎么不跳出来表演？"}, "正文字数": {"number": 316}, "年份": {"number": 2008}}, {"标题": {"text": "年线上的中国式喜剧"}, "发布时间": {"date": "2008-02-04"}, "主题": {"multi_select": ["中枢结构", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1108.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "技术上，十分凑巧的是，周五低点对应的线段刚好是360段，一个圆周。很多人老问3600是什么？为什么和上海指数相关？这问题大概不需要再问了吧。有人还要问，周五有底背驰吗？如果你连周五的背驰都看不出来，那只能重读了。看看15分钟图，想想该是哪两段比较力度？"}, "正文字数": {"number": 1436}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票98：中医、兵法、诗歌、操作2"}, "发布时间": {"date": "2008-02-04"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1109.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "一种思维模式的改变是很难的，因为一种思维模式的存在，往往连自己都不察觉，特别，一出现强烈走势后，那些老的毛病就又出来了。这几天的大盘转折走势，就是一个很好的例子。"}, "正文字数": {"number": 2060}, "年份": {"number": 2008}}, {"标题": {"text": "阴线迎春给一根筋上了生动一课"}, "发布时间": {"date": "2008-02-05"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1110.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "技术上的问题，昨天说得很清楚了，就是线段类背驰后必然出现1分钟中枢，节后，就看这中枢的演化，事情就这么简单，不需要任何一根筋的想法。而中短线上，还是4500点上下那中枢的震荡走势。"}, "正文字数": {"number": 765}, "年份": {"number": 2008}}, {"标题": {"text": "七绝一首恭贺新禧并告博客停业7天"}, "发布时间": {"date": "2008-02-05"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1111.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": ""}, "正文字数": {"number": 44}, "年份": {"number": 2008}}, {"标题": {"text": "开门不红又何妨？"}, "发布时间": {"date": "2008-02-13"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1112.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "至于大盘没有红，本ID可真没什么兴趣关心，具体的说法，在节前最后的帖子里已经无比清楚了。"}, "正文字数": {"number": 900}, "年份": {"number": 2008}}, {"标题": {"text": "后三日是技术上最关键时刻"}, "发布时间": {"date": "2008-02-14"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1114.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的580989，一个经典的走势，不管你是否参加，你都先请搞明白：今天尾盘的拉起故意和昨天是一样的，这就是一种典型的骗人手法，因为一根筋的人最多了，以为什么都是可以克隆，以为有一样的开始就有一样的结果，结果就给克死了。"}, "正文字数": {"number": 1295}, "年份": {"number": 2008}}, {"标题": {"text": "回试年线暂显支持"}, "发布时间": {"date": "2008-02-15"}, "主题": {"multi_select": ["政策与基本面"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/backyearline"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "今天回试年线暂显支持，但问题还是下周初，因为MACD的柱子是否有效放红，这是下周最关键的问题。目前的情况十分明确，就是技术面完全支持行情的展开，但基本面、政策面有太多令人不满意的因素，因此才有如此上下为难的局面。"}, "正文字数": {"number": 856}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐24：“你”、“你的”名、相、妄想"}, "发布时间": {"date": "2008-02-16"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1116.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "二、看到很多人说保定天鹅，那当然也会有行情的，只是最好的买入点早过了，去买，就是等于追高。注意，对高送配的，一定要小心其中利用题材出货的，因此那些过分炒作的一定要小心，另外，能提前知道消息介入那是最好的，如果没这渠道，消息公布后，上冲第一次回调确认时，只要没有出货现象，价位不高的，都是安全的。"}, "正文字数": {"number": 1017}, "年份": {"number": 2008}}, {"标题": {"text": "MACD红柱子终现待确认"}, "发布时间": {"date": "2008-02-18"}, "主题": {"multi_select": ["板块与个股", "中枢结构"]}, "大盘相关度": {"select": "相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1117.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "当然，以上都是些不精确的分析，如果按本ID的理论来，这些分析都没多大意义。现在就是一个中枢震荡的过程，这点说了多次了，今天并没构成线段类上涨，说明向上动力不足，因为今天构成的4575上下的1分钟中枢就有着重要的技术意义。后面的超短线走势完全由此中枢最终演变所决定。"}, "正文字数": {"number": 705}, "年份": {"number": 2008}}, {"标题": {"text": "教你炒股票99：走势结构的两重表里关系3"}, "发布时间": {"date": "2008-02-18"}, "主题": {"multi_select": ["中枢结构"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1118.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "走势结构，最重要的就是有中阴部分的存在。有人可能认为，中阴存在是理论不完善的结果，其实，这是典型的一根筋思维，对于这种思维，世界就是机械的，任何时候都只有一个机械精确的结果，而实际上，世界更多是量子化的，是测不准的，中阴的存在恰好客观地反映了走势的这种特性。"}, "正文字数": {"number": 1592}, "年份": {"number": 2008}}, {"标题": {"text": "CPI公布成突破契机"}, "发布时间": {"date": "2008-02-19"}, "主题": {"multi_select": ["中枢结构", "牛熊判断", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1119.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "昨天说了，今天要经受CPI公布的考验，结果大盘一直围绕4575的中枢震荡，CPI公布后也依然不变，下午更向上偏移，显示了最近少有的强势，最后一小时，就是中石油的表演，该股也如期回补前几天的缺口，但由于该股最近的大中枢并没有有效突破，所以这个回补只有震荡的意义，暂时不能给予太高的技术评价。"}, "正文字数": {"number": 615}, "年份": {"number": 2008}}, {"标题": {"text": "大规模增发猛于虎"}, "发布时间": {"date": "2008-02-20"}, "主题": {"multi_select": ["中枢结构", "板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1121.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "5200点那次，平安的增发成了最后的稻草，今天，又来了一个浦发的增发，虽然不是正式的消息，已经足以让大盘回头。"}, "正文字数": {"number": 850}, "年份": {"number": 2008}}, {"标题": {"text": "资本市场必须维持生态平衡"}, "发布时间": {"date": "2008-02-20"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chzhshch.blog/economics/ecologicalbalance"}}, "来源站点": {"select": "chzhshch.blog 官方镜像"}, "原文摘录": {"text": "环境保护、生态平衡已经是世界性的大问题，而资本市场，也同样存在一个环境保护、生态平衡的问题。在资本市场上活动的各种力量，之所以能存在一个系统中，就是之间有一个基本的协调关系，而一旦这个关系被打破了，这个资本市场的大系统就会出现生态危机。而一旦出现生态危机，这资本市场要恢复元气，那就不是一朝一夕的事情了。"}, "正文字数": {"number": 749}, "年份": {"number": 2008}}, {"标题": {"text": "赚钱是靠个股而不是指数"}, "发布时间": {"date": "2008-02-21"}, "主题": {"multi_select": ["中枢结构", "板块与个股"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1123.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天，昨天的传闻被证实了，在现代社会，空穴来风的事情很少有，特别在资本市场。指数勉强地维持了4575点的中枢震荡，这5分钟中枢是确定了，后面的关键是第三类买卖点的问题。"}, "正文字数": {"number": 683}, "年份": {"number": 2008}}, {"标题": {"text": "下周初决定大盘中线形态"}, "发布时间": {"date": "2008-02-22"}, "主题": {"multi_select": ["中枢结构", "牛熊判断", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1124.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天继续延续4695点浦发闹剧所制造的线段类下跌，在下午2点后最终出现一个类底背驰。该类下跌出现三个类中枢，类背驰后的回拉如理论所要求的最低幅度回到最后一个类中枢，也就是至少制造了一个1分钟中枢。最坏的情况，这中枢是一个新的1分钟下跌的第一个中枢；最好的情况，就是该1分钟中枢出现第三类买点，然后至少回到类下跌的第二个类中枢范围。因此，下周初该中枢的演化决定了大盘短线的形态。 而实际上，大盘下周初的走势还将决定大盘的中线形态。在前几天大盘MACD出红柱子时，已经说过，就是必须注意放几天红柱子后再次放绿柱子的情况，这样就对应着大盘再次破底形成头肩底形态。那么，下周，是否要出现这种情况，马上就要分晓。由于今天依然红柱子，因此还存在不出现绿柱子，红柱子再次伸长的情况，而这一切都将在下周有分晓。"}, "正文字数": {"number": 2269}, "年份": {"number": 2008}}, {"标题": {"text": "教你打坐25：列宁物质定义的荒谬"}, "发布时间": {"date": "2008-02-23"}, "主题": {"multi_select": ["大盘解读"]}, "大盘相关度": {"select": "一般"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1125.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "列宁本质上与马克思无关，列宁式的社会主义更和马克思无关，那不过是一个反资本主义的民族主义的资本主义过程，必然导致权力资本主义。列宁的社会主义，不过是以马克思的名义进行的一场上帝化、基督教化的人性闹剧，最终只证明了马克思结论的无比正确：社会主义不可能在一国单独实现。社会主义，只可能是资本主义全球化后的一个全球化事件，之前是一切所谓社会主义的闹剧，都不过是闹剧而已。"}, "正文字数": {"number": 1551}, "年份": {"number": 2008}}, {"标题": {"text": "新基金难敌乱增发"}, "发布时间": {"date": "2008-02-25"}, "主题": {"multi_select": ["中枢结构", "政策与基本面"]}, "大盘相关度": {"select": "高度相关"}, "原文链接": {"url": {"text": "查阅原文", "link": "https://chanshi.vip/archiver/?tid-1126.html"}}, "来源站点": {"select": "chanshi.vip 归档站"}, "原文摘录": {"text": "今天的走势，给那些政策迷好好上了一课，政策从来不是万能的，任何政策不过是市场的分力之一，最终决定市场的是合力。而所有的合力都写在走势之上，所以，今天的市场，如期地就把上周所分析的第三种走势给废掉了，后面，就是第二种走势的演化问题了，这也是我们反复强调的最有可能的走势。"}, "正文字数": {"number": 1175}, "年份": {"number": 2008}}]